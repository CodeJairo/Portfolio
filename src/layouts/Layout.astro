---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import ModalButton from "../components/modal-button.astro";
import { ClientRouter } from "astro:transitions";
import "aos/dist/aos.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = "Codejairo - Portfolio",
  description = "Portafolio profesional de Jairo Herrera, ingeniero de software full-stack especializado en interfaces web reactivas, arquitecturas backend escalables, sistemas distribuidos y seguridad.",
  ogImage = "/profile.png",
  ogType = "website",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://codejairo.netlify.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>

    <meta
      name="google-site-verification"
      content="Gin_eIJSFyOSLv5TZp5qdr5fdvFeuFHK86kMImsSkOY"
    />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Jairo Herrera, codejairo, ingeniero de software, desarrollador full stack, Astro, Angular, React, FastAPI, NestJS, PostgreSQL, Medellín, Guardrail API, Fintech Fraud Detection, ESP Contrata, Higinex"
    />
    <meta name="author" content="Jairo Herrera" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Redes Sociales (LinkedIn, Facebook, WhatsApp) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CodeJairo" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@codejairo" />
    <meta name="twitter:creator" content="@codejairo" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <!-- Astro 5 Client Router (Navegación Fluida SPA) -->
    <ClientRouter />

    <script
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
      defer></script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jairo Herrera",
        "url": "https://codejairo.netlify.app",
        "sameAs": [
          "https://github.com/codejairo",
          "https://www.linkedin.com/in/codejairo/"
        ],
        "jobTitle": "Ingeniero de Software Full-Stack",
        "description": "Portafolio de Jairo Herrera, ingeniero de software full-stack especializado en interfaces web reactivas, arquitecturas backend escalables, sistemas distribuidos y seguridad."
      }
    </script>

    <!-- Script Anti-FOUC para Tema y Soporte de Transiciones SPA -->
    <script is:inline>
      const syncTheme = () => {
        const theme = (() => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme");
          }
          return "dark";
        })();
        document.documentElement.classList.toggle("dark", theme === "dark");
      };

      syncTheme();

      document.addEventListener("astro:after-swap", () => {
        syncTheme();
        if (window.Alpine) {
          window.Alpine.initTree(document.body);
        }
      });
    </script>
  </head>
  <body
    class="bg-white dark:bg-black text-black dark:text-gray-100 overflow-x-hidden"
  >
    <!-- Background Gradient & Noise -->
    <div class="fixed inset-0 z-[-1] pointer-events-none">
      <div
        class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-purple-400/30 dark:bg-purple-900/20 rounded-full blur-[120px] animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-400/30 dark:bg-blue-900/20 rounded-full blur-[120px] animate-pulse delay-1000"
      >
      </div>
      <div
        class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
      >
      </div>
    </div>

    <Navbar />
    <main>
      <slot />
    </main>
    <ModalButton />
    <Footer />

    <script>
      import AOS from "aos";

      const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const initAOS = () => {
        if (prefersReducedMotion()) {
          document.documentElement.setAttribute("data-reduced-motion", "true");
          document.querySelectorAll("[data-aos]").forEach((element) => {
            element.classList.add("aos-animate");
          });
          return;
        }

        document.documentElement.removeAttribute("data-reduced-motion");

        const isProjectPage = window.location.pathname.startsWith("/projects/");

        const profile = isProjectPage
          ? {
              duration: 460,
              easing: "ease-out-sine",
              offset: 40,
            }
          : {
              duration: 700,
              easing: "ease-out-cubic",
              offset: 80,
            };

        AOS.init({
          ...profile,
          once: true,
          mirror: false,
          disable: false,
        });

        AOS.refreshHard();
      };

      document.addEventListener("astro:page-load", initAOS);
      initAOS();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
