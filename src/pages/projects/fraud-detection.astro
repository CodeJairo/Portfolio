---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const REPO_URL = "https://github.com/CodeJairo/fraud-detection";
const LIVE_DEMO_URL = "https://determined-benevolence-production-da1a.up.railway.app/";

const kpis = [
  { value: "<5ms", label: "Latencia de inferencia", detail: "Evaluación transaccional por API" },
  { value: "6M+", label: "Eventos procesados", detail: "Dataset financiero PaySim" },
  { value: "3", label: "Capas Medallion", detail: "Bronze, Silver, Gold" },
  { value: "38/38", label: "Pruebas", detail: "Suite automatizada en Pytest" },
];

const pipeline = [
  {
    stage: "01 · Ingesta",
    title: "Streaming transaccional",
    tech: "Redpanda / Kafka",
    description: "Consumo por particiones, micro-batches y persistencia inicial en formato columnar.",
  },
  {
    stage: "02 · Normalización",
    title: "Motor analítico",
    tech: "Polars",
    description: "Depuración, reconciliación de saldos y generación de señales para entrenamiento e inferencia.",
  },
  {
    stage: "03 · Scoring",
    title: "Riesgo híbrido",
    tech: "LightGBM + reglas",
    description: "Combinación de probabilidad estadística con reglas de negocio para alertas accionables.",
  },
  {
    stage: "04 · Serving",
    title: "Respuesta en vivo",
    tech: "FastAPI",
    description: "Exposición de endpoint de evaluación para aprobación o bloqueo preventivo.",
  },
];

const rules = [
  "Inconsistencias contables de alto impacto en transferencias y retiros.",
  "Rutas de fondos hacia cuentas destino sin comportamiento financiero saludable.",
  "Ráfagas operativas anómalas en intervalos cortos del mismo usuario.",
];
---

<Layout
  title="Fintech Fraud Detection | CodeJairo"
  description="Plataforma de detección de fraude en tiempo real con arquitectura Medallion, Polars, LightGBM y FastAPI."
>
  <main class="relative overflow-hidden bg-gradient-to-b from-zinc-950 via-slate-950 to-black text-zinc-100">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 left-[-8%] w-96 h-96 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="absolute top-[24%] right-[-10%] w-[28rem] h-[28rem] rounded-full bg-cyan-500/15 blur-3xl"></div>
      <div class="absolute bottom-[-8rem] left-[35%] w-[30rem] h-[30rem] rounded-full bg-indigo-500/15 blur-3xl"></div>
    </div>

    <section class="relative z-10 pt-28 pb-16 px-6 sm:px-10 lg:px-20" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-400/30 bg-emerald-500/10 text-emerald-300 text-xs font-bold uppercase tracking-wide">
          Cyber/Data Case
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Tiempo real
        </div>

        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Fintech Fraud Detection
          <span class="block bg-gradient-to-r from-emerald-300 via-cyan-300 to-indigo-300 bg-clip-text text-transparent">
            Streaming + Risk Scoring
          </span>
        </h1>

        <p class="mt-6 text-lg text-zinc-300 max-w-3xl leading-relaxed">
          Plataforma para detección de fraude financiero en flujo continuo. El objetivo: transformar eventos transaccionales en decisiones de riesgo rápidas, trazables y operables.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={LIVE_DEMO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-zinc-950 font-bold hover:scale-105 transition-transform">
            Ver demo
          </a>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 text-white font-semibold hover:border-emerald-300 transition-colors">
            Repositorio
          </a>
        </div>

        <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {kpis.map((kpi) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 backdrop-blur-sm">
              <p class="text-2xl font-extrabold text-emerald-300">{kpi.value}</p>
              <p class="text-xs font-semibold uppercase tracking-wide text-zinc-100 mt-1">{kpi.label}</p>
              <p class="text-xs text-zinc-400 mt-1.5">{kpi.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="relative z-10 py-12 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="80">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold">Arquitectura de decisión</h2>
        <div class="mt-6 grid md:grid-cols-2 xl:grid-cols-4 gap-4">
          {pipeline.map((step) => (
            <article class="rounded-2xl border border-cyan-400/20 bg-cyan-500/5 p-5">
              <p class="text-xs font-bold uppercase tracking-wide text-cyan-300">{step.stage}</p>
              <h3 class="text-lg font-bold text-white mt-2">{step.title}</h3>
              <p class="text-xs font-semibold text-emerald-300 mt-1">{step.tech}</p>
              <p class="text-sm text-zinc-300 mt-3 leading-relaxed">{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="relative z-10 py-12 pb-20 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="120">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_0.9fr] gap-5">
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-7">
          <h2 class="text-2xl font-bold text-white">Enfoque de riesgo híbrido</h2>
          <p class="mt-4 text-zinc-300 leading-relaxed">
            El scoring final mezcla señal estadística de LightGBM y reglas contables de negocio para reducir falsos negativos y mantener trazabilidad técnica ante auditoría.
          </p>
          <ul class="mt-5 space-y-2.5 text-sm text-zinc-300">
            {rules.map((rule) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </article>

        <aside class="rounded-3xl border border-emerald-400/20 bg-emerald-500/10 p-7">
          <h3 class="text-xl font-bold text-white">Resultado que persigue la plataforma</h3>
          <p class="mt-3 text-sm text-zinc-200 leading-relaxed">
            Responder rápido frente a patrones de fraude, con señales técnicas explicables para operación y mejora continua del modelo.
          </p>
          <a href="/#proyectos" class="inline-flex mt-6 items-center gap-2 px-5 py-2.5 rounded-full bg-black/30 border border-white/20 text-sm font-semibold hover:border-emerald-300 transition-colors">
            Volver a proyectos
          </a>
        </aside>
      </div>
    </section>
  </main>
</Layout>
