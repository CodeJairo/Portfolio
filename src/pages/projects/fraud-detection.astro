---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const REPO_URL = "https://github.com/CodeJairo/fraud-detection";
const LIVE_DEMO_URL = "https://determined-benevolence-production-da1a.up.railway.app/";

const metrics = [
  { value: "<5ms", label: "Latencia de inferencia", detail: "Evaluación en tiempo real por API" },
  { value: "6M+", label: "Transacciones PaySim", detail: "Procesamiento distribuido en streaming" },
  { value: "100%", label: "PR-AUC en Test", detail: "Clasificador LightGBM balanceado" },
  { value: "38 / 38", label: "Tests Automatizados", detail: "Cobertura completa con Pytest" },
];

const medallionLayers = [
  {
    tier: "BRONZE",
    badge: "bg-amber-500/15 text-amber-700 dark:text-amber-400 border-amber-500/30",
    title: "Ingesta en Streaming & Parquet Inmutable",
    tech: "Redpanda (Kafka) + PyArrow",
    description:
      "Ingesta distribuida desde el topic transactions.raw con 3 particiones por nameOrig. Micro-batches dinámicos con commits manuales síncronos garantizando semántica at-least-once y trazabilidad UTC inmutable.",
    points: [
      "Particionado estricto por cliente emisor (nameOrig)",
      "Micro-batches por ventana temporal o volumen de mensajes",
      "Persistencia columnar en formato Parquet particionado",
      "Garantía de entrega at-least-once sin pérdida de transacciones",
    ],
  },
  {
    tier: "SILVER",
    badge: "bg-slate-500/15 text-slate-700 dark:text-slate-300 border-slate-500/30",
    title: "Motor Analítico & Feature Engineering Vectorial",
    tech: "Polars (Rust Engine)",
    description:
      "Limpieza, deduplicación por clave de negocio y cálculo masivo de ecuaciones contables de balance mediante lazy evaluation en Polars, alcanzando rendimiento órdenes de magnitud superior a Pandas.",
    points: [
      "Deduplicación atómica por clave compuesta transaccional",
      "Cálculo de error contable de balance origen y destino",
      "Mapeo y normalización de tipologías de cuenta (Client/Merchant)",
      "Generación de features vectorizadas para entrenamiento ML",
    ],
  },
  {
    tier: "GOLD",
    badge: "bg-yellow-500/15 text-yellow-700 dark:text-yellow-400 border-yellow-500/30",
    title: "Motor Híbrido de Scoring & Perfiles KYC",
    tech: "LightGBM + Reglas Contables",
    description:
      "Fusión ponderada 50/50 entre 3 reglas deterministas de negocio y la probabilidad estadística del modelo supervisado LightGBM, generando alertas categorizadas y perfiles de riesgo acumulado por usuario.",
    points: [
      "Fórmula de riesgo: 0.5 * Reglas + 0.5 * (Prob_ML * 100)",
      "Manejo de desbalance severo con class_weight='balanced'",
      "Dataset analítico de alertas de fraude clasificadas",
      "Perfil de riesgo histórico de usuario para KYC continuo",
    ],
  },
];

const businessRules = [
  {
    id: "R1",
    score: "50 pts",
    name: "Inconsistencia Severa de Saldos",
    condition: "Discrepancia contable ≠ 0 en TRANSFER o CASH_OUT con montos ≥ $200,000.",
    impact: "Detecta sustracción ilícita de fondos donde el balance resultante no concuerda con la transacción debitada.",
  },
  {
    id: "R2",
    score: "35 pts",
    name: "Transferencia a Cero Destino (Cuentas Mula)",
    condition: "Transferencias ≥ $200,000 hacia cuentas con saldo previo y posterior en cero.",
    impact: "Identifica cuentas instrumentales creadas únicamente para disipar o puentear fondos en esquemas de lavado.",
  },
  {
    id: "R3",
    score: "25 pts",
    name: "Ráfaga Operativa Anómala",
    condition: "≥ 2 transacciones de alto impacto de un mismo usuario dentro del mismo intervalo temporal (step).",
    impact: "Mitiga ataques automatizados de vaciado veloz de cuentas antes del bloqueo de credenciales.",
  },
];

const techStack = [
  { name: "Python 3.14+", category: "Lenguaje", description: "Entorno moderno con tipado estricto y uv" },
  { name: "Redpanda (Kafka)", category: "Streaming", description: "Broker de mensajería compatible con Apache Kafka" },
  { name: "Polars", category: "Data Engine", description: "Motor DataFrame columnar en Rust de alta velocidad" },
  { name: "LightGBM", category: "Machine Learning", description: "Gradient Boosting optimizado para datos tabulares" },
  { name: "FastAPI", category: "Microservicio", description: "API REST asíncrona con validación Pydantic v2 (<5ms)" },
  { name: "Streamlit", category: "Dashboard", description: "Centro de comando interactivo con gráficos Plotly" },
  { name: "PyArrow", category: "Almacenamiento", description: "Lectura/escritura optimizada de archivos Parquet" },
  { name: "Scikit-Learn", category: "ML Pipeline", description: "OneHotEncoder y preprocesamiento de características" },
  { name: "Docker Compose", category: "DevOps", description: "Entornos reproducibles para Redpanda y Console" },
  { name: "Pytest", category: "Calidad", description: "Suite de 38 pruebas unitarias y de integración" },
];

const skills = [
  "Diseño e implementación de arquitectura Lakehouse Medallion (Bronze, Silver, Gold)",
  "Ingesta de flujos de eventos transaccionales en streaming con Kafka/Redpanda",
  "Optimización de procesamiento analítico masivo en memoria con Polars",
  "Entrenamiento y calibración de clasificadores de Machine Learning con desbalance extremo",
  "Desarrollo de microservicios REST de baja latencia (<5ms) con FastAPI y Pydantic v2",
  "Pruebas automatizadas continuas (TDD) y contenerización con Docker",
];
---

<Layout
  title="Fintech Fraud Detection Platform | CodeJairo"
  description="Plataforma de detección de fraude financiero en streaming en tiempo real con arquitectura Medallion, Polars, Redpanda, LightGBM y FastAPI."
>
  <div class="relative bg-gradient-to-b from-emerald-50/50 via-white to-cyan-50/40 dark:from-slate-950 dark:via-zinc-900 dark:to-black text-zinc-900 dark:text-white transition-colors duration-300">
    <!-- Ambient Background Glows -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="absolute -top-32 -left-24 w-96 h-96 rounded-full bg-emerald-400/20 dark:bg-emerald-500/15 blur-3xl"></div>
      <div class="absolute top-[25%] -right-24 w-96 h-96 rounded-full bg-cyan-400/20 dark:bg-cyan-500/15 blur-3xl"></div>
      <div class="absolute top-[60%] left-1/4 w-[500px] h-[500px] rounded-full bg-indigo-400/15 dark:bg-indigo-500/10 blur-3xl"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative z-10 pt-28 pb-16 md:py-24 px-4 sm:px-8 md:px-12 lg:px-24" data-aos="fade-up" data-aos-duration="420">
      <div class="max-w-6xl mx-auto text-center">
        <!-- Top Badges -->
        <div class="flex flex-wrap justify-center items-center gap-2 mb-6">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25 dark:border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
            Streaming Lakehouse & ML
          </span>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-cyan-500/10 dark:bg-cyan-500/15 text-cyan-700 dark:text-cyan-400 border border-cyan-500/25 dark:border-cyan-500/30">
            Python 3.14 · uv
          </span>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-indigo-500/10 dark:bg-indigo-500/15 text-indigo-700 dark:text-indigo-400 border border-indigo-500/25 dark:border-indigo-500/30">
            38/38 Tests Passing
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-4">
          Fintech Fraud Detection <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-emerald-600 via-cyan-600 to-indigo-600 dark:from-emerald-400 dark:via-cyan-400 dark:to-indigo-400 bg-clip-text text-transparent">
            Platform
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto leading-relaxed mb-8">
          Detección de fraude financiero en streaming y tiempo real construida bajo la <strong class="text-zinc-900 dark:text-white">Arquitectura Medallion</strong>. Ingesta desde Kafka/Redpanda, reconciliación contable con <strong class="text-zinc-900 dark:text-white">Polars</strong>, motor de riesgo híbrido y microservicio REST con latencia inferior a <strong class="text-zinc-900 dark:text-white">5ms</strong>.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap justify-center gap-4 mb-16">
          <a
            href={LIVE_DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-7 sm:px-8 py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-zinc-950 font-bold hover:scale-105 transition-transform shadow-lg shadow-emerald-500/25"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-950 animate-pulse"></span>
            Probar Aplicación en Vivo
          </a>
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 sm:px-8 py-3.5 rounded-full bg-white/80 dark:bg-white/10 hover:bg-zinc-100 dark:hover:bg-white/15 text-zinc-900 dark:text-white font-bold border border-zinc-300 dark:border-white/20 transition-all shadow-sm"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Repositorio GitHub
          </a>
          <a
            href="#arquitectura"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white font-medium transition-colors"
          >
            Explorar Arquitectura ↓
          </a>
        </div>

        <!-- Metrics Grid -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-5xl mx-auto">
          {metrics.map((m) => (
            <div class="p-4 sm:p-5 rounded-2xl bg-white/80 dark:bg-white/5 border border-zinc-200/80 dark:border-white/10 backdrop-blur-sm shadow-sm dark:shadow-none hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-colors">
              <p class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">{m.value}</p>
              <p class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-white mt-1">{m.label}</p>
              <p class="text-[11px] sm:text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{m.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Interactive Live Platform Dock / Browser Mockup -->
    <section id="demo-en-vivo" class="scroll-mt-24 relative z-10 py-8 px-4 sm:px-8 md:px-12 lg:px-24" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="relative rounded-3xl border border-zinc-200/80 dark:border-white/15 bg-white/95 dark:bg-zinc-900/95 shadow-2xl overflow-hidden backdrop-blur-xl">
          <!-- Dock Title Bar -->
          <div class="px-4 sm:px-6 py-3.5 bg-zinc-100/90 dark:bg-zinc-950/90 border-b border-zinc-200/80 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
            <!-- Window Dots & Status Badge -->
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block"></span>
              </div>
              <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Despliegue Activo en Railway
              </div>
            </div>

            <!-- Address Bar Mock -->
            <div class="flex-1 max-w-lg mx-auto hidden md:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-black/40 border border-zinc-200/80 dark:border-white/10 text-xs text-zinc-600 dark:text-zinc-400 font-mono shadow-inner">
              <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <span class="truncate">https://determined-benevolence-production-da1a.up.railway.app</span>
              <span class="ml-auto text-[10px] uppercase font-bold text-emerald-600 dark:text-emerald-400">SSL</span>
            </div>

            <!-- Quick Action Links -->
            <div class="flex items-center gap-2">
              <a
                href={LIVE_DEMO_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition-colors inline-flex items-center gap-1.5 shadow-sm"
              >
                <span>Abrir en Pantalla Completa</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a
                href={REPO_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex px-3 py-1.5 rounded-full text-xs font-semibold bg-zinc-200/80 dark:bg-white/10 hover:bg-zinc-300 dark:hover:bg-white/20 text-zinc-800 dark:text-white transition-colors items-center gap-1"
              >
                GitHub
              </a>
            </div>
          </div>

          <!-- Embedded Interactive Frame with Scroll Shield -->
          <div
            x-data="{ active: false }"
            @keydown.escape.window="active = false"
            class="relative w-full h-[620px] sm:h-[720px] lg:h-[780px] bg-zinc-100 dark:bg-zinc-950"
          >
            <!-- Shield Overlay (prevents mouse wheel trapping while scrolling) -->
            <div
              x-show="!active"
              @click="active = true"
              class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/35 hover:bg-black/25 backdrop-blur-[1.5px] transition-all cursor-pointer group px-4 text-center"
            >
              <div class="px-6 py-3.5 rounded-2xl bg-zinc-900/95 dark:bg-black/95 border border-white/20 text-white shadow-2xl flex items-center gap-3 group-hover:scale-105 group-hover:border-emerald-500/50 transition-all">
                <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-sm font-bold">Haz clic aquí para interactuar con la aplicación</span>
                <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30">Activar</span>
              </div>
              <p class="text-xs text-white/80 mt-2.5 font-medium drop-shadow">
                (El desplazamiento de página se mantiene libre y fluido mientras no esté activa la interacción)
              </p>
            </div>

            <!-- Exit Button when active -->
            <button
              x-cloak
              x-show="active"
              @click="active = false"
              class="absolute top-4 right-4 z-30 px-3.5 py-1.5 rounded-full bg-zinc-900/90 hover:bg-black text-white text-xs font-semibold border border-white/20 shadow-xl flex items-center gap-1.5 transition-all"
              title="Salir de la interacción para desplazarte libremente por la página"
            >
              <span>Salir de interacción</span>
              <kbd class="text-[10px] bg-white/20 px-1.5 py-0.5 rounded font-mono">Esc</kbd>
            </button>

            <!-- Iframe -->
            <iframe
              src={LIVE_DEMO_URL}
              title="Fintech Fraud Detection Live Platform on Railway"
              class="w-full h-full border-0"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
            ></iframe>
          </div>

          <!-- Bottom Dock Footer -->
          <div class="px-5 sm:px-6 py-4 bg-zinc-50/90 dark:bg-zinc-950/90 border-t border-zinc-200/80 dark:border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span><strong>Sandbox Interactivo en Vivo:</strong> Puedes ejecutar inferencias en tiempo real, ajustar parámetros transaccionales y auditar perfiles KYC directamente en este visor.</span>
            </div>
            <a
              href={LIVE_DEMO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1 ml-auto"
            >
              Abrir URL independiente de Railway →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- El Problema y Desafíos de Ingeniería -->
    <section class="relative z-10 py-16 md:py-20 px-4 sm:px-8 md:px-12 lg:px-24" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">Contexto de Fraude Financiero</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">El Desafío Técnico</h2>
          <p class="text-zinc-600 dark:text-zinc-400 mt-3 max-w-2xl mx-auto">
            Por qué los sistemas tradicionales de reglas estáticas fallan ante esquemas de fraude modernos.
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-start">
          <div class="space-y-5 bg-white/80 dark:bg-white/5 p-6 sm:p-7 rounded-3xl border border-zinc-200/80 dark:border-white/10 shadow-sm backdrop-blur-sm">
            <h3 class="text-xl font-bold text-emerald-600 dark:text-emerald-400">Las Limitaciones del Enfoque Tradicional</h3>
            <p class="text-zinc-600 dark:text-zinc-300 leading-relaxed text-sm sm:text-base">
              En plataformas de pagos y billeteras digitales, el fraude ocurre en milisegundos. Los sistemas basados únicamente en reglas manuales sufren de altos falsos positivos y quedan obsoletos ante patrones emergentes, mientras que los modelos de Machine Learning aislados suelen carecer de explicabilidad para auditorías regulatorias.
            </p>
            <p class="text-zinc-600 dark:text-zinc-300 leading-relaxed text-sm sm:text-base">
              Además, el desbalance extremo de clases (menos del 1% de transacciones fraudulentas en millones de eventos) hace que los modelos convencionales fallen al priorizar la precisión general sobre la detección del delito.
            </p>
            <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20">
              <p class="text-xs sm:text-sm text-emerald-800 dark:text-emerald-300 font-medium">
                La solución requería una arquitectura híbrida: reglas deterministas de balance contable respaldadas por un clasificador LightGBM entrenado con ponderación asimétrica de clases.
              </p>
            </div>
          </div>

          <div class="grid gap-4">
            <div class="p-5 rounded-2xl bg-white/80 dark:bg-white/5 border border-zinc-200/80 dark:border-white/10 hover:border-emerald-500/30 dark:hover:border-emerald-500/30 transition-colors shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <span class="w-8 h-8 rounded-lg bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">01</span>
                <h4 class="font-bold text-zinc-900 dark:text-white">Streaming a Gran Escala</h4>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">Ingesta continua particionada con Redpanda/Kafka evitando cuellos de botella mediante micro-batching dinámico.</p>
            </div>

            <div class="p-5 rounded-2xl bg-white/80 dark:bg-white/5 border border-zinc-200/80 dark:border-white/10 hover:border-cyan-500/30 dark:hover:border-cyan-500/30 transition-colors shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <span class="w-8 h-8 rounded-lg bg-cyan-500/15 text-cyan-700 dark:text-cyan-400 flex items-center justify-center font-bold text-sm">02</span>
                <h4 class="font-bold text-zinc-900 dark:text-white">Rendimiento Columnar con Polars</h4>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">Reconciliación de balances contables y deduplicación atómica ejecutada sobre millones de filas sin sobrecargar la memoria.</p>
            </div>

            <div class="p-5 rounded-2xl bg-white/80 dark:bg-white/5 border border-zinc-200/80 dark:border-white/10 hover:border-indigo-500/30 dark:hover:border-indigo-500/30 transition-colors shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <span class="w-8 h-8 rounded-lg bg-indigo-500/15 text-indigo-700 dark:text-indigo-400 flex items-center justify-center font-bold text-sm">03</span>
                <h4 class="font-bold text-zinc-900 dark:text-white">Inferencia Sub-5ms en Vivo</h4>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">Evaluación transaccional asíncrona mediante microservicio FastAPI para aprobación o bloqueo preventivo en la pasarela.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pipeline Medallion Interactivo -->
    <section id="arquitectura" class="scroll-mt-24 relative z-10 py-16 md:py-20 px-4 sm:px-8 md:px-12 lg:px-24 bg-zinc-100/70 dark:bg-zinc-950/60 border-y border-zinc-200/60 dark:border-white/5" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-widest">Ingeniería de Datos</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">La Arquitectura Medallion</h2>
          <p class="text-zinc-600 dark:text-zinc-400 mt-3 max-w-2xl mx-auto">
            Procesamiento por etapas con lakehouse estructurado: desde el evento crudo en el broker hasta el dataset de decisiones y auditoría.
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-6">
          {medallionLayers.map((layer) => (
            <div class="flex flex-col p-6 rounded-3xl bg-white/90 dark:bg-zinc-900 border border-zinc-200/80 dark:border-white/10 hover:border-zinc-300 dark:hover:border-white/20 transition-all shadow-md dark:shadow-xl">
              <div class="flex items-center justify-between mb-4">
                <span class={`text-[11px] font-bold px-3 py-1 rounded-full border ${layer.badge}`}>
                  CAPA {layer.tier}
                </span>
                <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">{layer.tech}</span>
              </div>

              <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">{layer.title}</h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">{layer.description}</p>

              <div class="space-y-2.5 mt-auto pt-4 border-t border-zinc-200/80 dark:border-white/10">
                {layer.points.map((p) => (
                  <div class="flex items-start gap-2.5 text-xs text-zinc-700 dark:text-zinc-300">
                    <span class="mt-1 w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 shrink-0"></span>
                    <span>{p}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Motor Híbrido: Reglas de Negocio -->
    <section class="relative z-10 py-16 md:py-20 px-4 sm:px-8 md:px-12 lg:px-24" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-bold text-amber-600 dark:text-yellow-400 uppercase tracking-widest">Lógica de Detección</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">Motor de Reglas Contables</h2>
          <p class="text-zinc-600 dark:text-zinc-400 mt-3 max-w-2xl mx-auto">
            Reglas deterministas que complementan al modelo estadístico para detectar anomalías flagrantes en balances y transferencias.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {businessRules.map((rule) => (
            <div class="p-6 rounded-3xl bg-white/80 dark:bg-white/5 border border-zinc-200/80 dark:border-white/10 hover:border-amber-500/40 dark:hover:border-yellow-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between mb-4">
                <span class="text-sm font-bold text-amber-600 dark:text-yellow-400">{rule.id}</span>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-amber-500/15 dark:bg-yellow-500/15 text-amber-700 dark:text-yellow-400 border border-amber-500/30 dark:border-yellow-500/30">
                  {rule.score}
                </span>
              </div>
              <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">{rule.name}</h3>
              <p class="text-xs font-mono text-emerald-700 dark:text-emerald-400 bg-zinc-100 dark:bg-black/40 p-2.5 rounded-lg border border-zinc-200/80 dark:border-white/5 mb-4 break-words">
                {rule.condition}
              </p>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">{rule.impact}</p>
            </div>
          ))}
        </div>

        <!-- Formula Highlight -->
        <div class="mt-8 p-6 rounded-2xl bg-gradient-to-r from-emerald-100/70 via-cyan-100/70 to-indigo-100/70 dark:from-emerald-950/40 dark:via-cyan-950/40 dark:to-indigo-950/40 border border-emerald-500/30 dark:border-emerald-500/20 text-center shadow-sm">
          <p class="text-xs uppercase font-bold tracking-wider text-emerald-700 dark:text-emerald-400 mb-1">Ecuación del Score de Riesgo Unificado</p>
          <p class="text-base sm:text-xl font-mono text-zinc-900 dark:text-white font-bold break-words">
            Risk_Score = 0.5 × Rules_Score + 0.5 × (ML_Probability × 100)
          </p>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2">
            Severidad: LOW (&lt;40) · MEDIUM (40–69) · HIGH (≥70). Alertas automáticas emitidas a compliance en tiempo real.
          </p>
        </div>
      </div>
    </section>

    <!-- Serving Layer: FastAPI y Streamlit -->
    <section class="relative z-10 py-16 md:py-20 px-4 sm:px-8 md:px-12 lg:px-24 bg-zinc-100/70 dark:bg-zinc-950/60 border-y border-zinc-200/60 dark:border-white/5" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">Capa de Consumo</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">Servicios REST & Centro de Mando</h2>
        </div>

        <div class="grid lg:grid-cols-2 gap-8">
          <!-- FastAPI Microservice -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white/90 dark:bg-zinc-900 border border-zinc-200/80 dark:border-white/10 shadow-md dark:shadow-xl space-y-4">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-teal-500/15 text-teal-700 dark:text-teal-400 flex items-center justify-center font-bold text-lg">⚡</span>
              <div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Microservicio FastAPI (&lt;5ms)</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400">Inferencia en vivo con Pydantic v2 y OpenAPI/Swagger</p>
              </div>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
              Expone endpoints asíncronos para evaluación transaccional instantánea en pasarelas de pago, consulta de alertas activas y verificación KYC de perfiles de riesgo acumulado.
            </p>
            <div class="space-y-2 font-mono text-xs overflow-x-auto">
              <div class="flex items-center gap-2 p-2.5 rounded-lg bg-zinc-100 dark:bg-black/50 border border-zinc-200 dark:border-white/5 min-w-[280px]">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">POST</span>
                <span class="text-zinc-800 dark:text-zinc-300">/evaluate</span>
                <span class="text-zinc-500 ml-auto text-[11px]">&lt;5ms scoring</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-lg bg-zinc-100 dark:bg-black/50 border border-zinc-200 dark:border-white/5 min-w-[280px]">
                <span class="text-cyan-600 dark:text-cyan-400 font-bold">GET</span>
                <span class="text-zinc-800 dark:text-zinc-300">/alerts</span>
                <span class="text-zinc-500 ml-auto text-[11px]">Filtros por riesgo &amp; ML</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-lg bg-zinc-100 dark:bg-black/50 border border-zinc-200 dark:border-white/5 min-w-[280px]">
                <span class="text-indigo-600 dark:text-indigo-400 font-bold">GET</span>
                <span class="text-zinc-800 dark:text-zinc-300">/users/{`{name_orig}`}/risk-profile</span>
                <span class="text-zinc-500 ml-auto text-[11px]">Historial KYC</span>
              </div>
            </div>
          </div>

          <!-- Streamlit Dashboard -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white/90 dark:bg-zinc-900 border border-zinc-200/80 dark:border-white/10 shadow-md dark:shadow-xl space-y-4">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-rose-500/15 text-rose-700 dark:text-rose-400 flex items-center justify-center font-bold text-lg">📊</span>
              <div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Centro de Comando Streamlit</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400">Operaciones forenses y simulador interactivo</p>
              </div>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
              Consola interactiva diseñada para analistas de riesgo financiero con métricas ejecutivas en vivo, matriz de decisión de 4 cuadrantes (reglas vs. ML), auditoría KYC y sandbox para simular transacciones.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-white/5 border border-zinc-200/80 dark:border-white/5">
                <p class="font-bold text-zinc-900 dark:text-white">Matriz 4 Cuadrantes</p>
                <p class="text-zinc-600 dark:text-zinc-400 mt-1">Inspección de concordancia entre ML y reglas</p>
              </div>
              <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-white/5 border border-zinc-200/80 dark:border-white/5">
                <p class="font-bold text-zinc-900 dark:text-white">Sandbox Interactivo</p>
                <p class="text-zinc-600 dark:text-zinc-400 mt-1">Evaluación en vivo con sliders de prueba</p>
              </div>
              <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-white/5 border border-zinc-200/80 dark:border-white/5">
                <p class="font-bold text-zinc-900 dark:text-white">Auditoría KYC</p>
                <p class="text-zinc-600 dark:text-zinc-400 mt-1">Desglose histórico del cliente con 1 clic</p>
              </div>
              <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-white/5 border border-zinc-200/80 dark:border-white/5">
                <p class="font-bold text-zinc-900 dark:text-white">Visualización Plotly</p>
                <p class="text-zinc-600 dark:text-zinc-400 mt-1">Distribución de riesgo y series de tiempo</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack Técnico -->
    <section class="relative z-10 py-16 md:py-20 px-4 sm:px-8 md:px-12 lg:px-24" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">Tecnologías Utilizadas</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">Stack Tecnológico</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {techStack.map((tech, idx) => (
            <div class="p-4 rounded-2xl bg-white/80 dark:bg-white/5 border border-zinc-200/80 dark:border-white/10 hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">{tech.category}</span>
                <span class="text-[10px] font-semibold text-zinc-400 dark:text-zinc-500">0{idx + 1}</span>
              </div>
              <h3 class="text-sm font-bold text-zinc-900 dark:text-white">{tech.name}</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">{tech.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Aprendizajes y Capacidades -->
    <section class="relative z-10 py-16 md:py-20 px-4 sm:px-8 md:px-12 lg:px-24 bg-gradient-to-br from-emerald-50/70 via-white to-cyan-50/60 dark:from-emerald-950/60 dark:via-zinc-900 dark:to-black border-t border-zinc-200/60 dark:border-white/5" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">Lo que demuestro</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">Capacidades de Ingeniería Clave</h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skills.map((skill, index) => (
            <div class="p-5 rounded-2xl bg-white/80 dark:bg-black/40 border border-zinc-200/80 dark:border-white/10 hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-colors shadow-sm">
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Capacidad 0{index + 1}</span>
              <p class="text-sm text-zinc-800 dark:text-white font-medium mt-2 leading-relaxed">{skill}</p>
            </div>
          ))}
        </div>

        <!-- Footer CTA -->
        <div class="mt-16 text-center space-y-6">
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">¿Deseas conocer más detalles de la arquitectura?</h3>
          <p class="text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto text-sm">
            Puedes explorar el código fuente completo, ejecutar la suite de pruebas o levantar el entorno localmente desde el repositorio de GitHub.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={LIVE_DEMO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-7 sm:px-8 py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-zinc-950 font-bold hover:scale-105 transition-transform shadow-lg shadow-emerald-500/25"
            >
              <span class="w-2 h-2 rounded-full bg-zinc-950 animate-pulse"></span>
              Probar Aplicación en Vivo
            </a>
            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-7 sm:px-8 py-3.5 rounded-full bg-white/80 dark:bg-white/10 hover:bg-zinc-100 dark:hover:bg-white/15 text-zinc-900 dark:text-white font-bold border border-zinc-300 dark:border-white/20 transition-all shadow-sm"
            >
              Ver Proyecto en GitHub
            </a>
            <a
              href="/#proyectos"
              class="inline-flex items-center gap-2 px-7 sm:px-8 py-3.5 rounded-full bg-white/80 dark:bg-white/10 hover:bg-zinc-100 dark:hover:bg-white/15 text-zinc-900 dark:text-white font-bold border border-zinc-300 dark:border-white/20 transition-all shadow-sm"
            >
              ← Volver a todos los proyectos
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
