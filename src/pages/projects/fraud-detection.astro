---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import fraudPreview from "../../assets/fraud-detection/fraud-preview.png";

const REPO_URL = "https://github.com/CodeJairo/fraud-detection";
const LIVE_DEMO_URL = "https://determined-benevolence-production-da1a.up.railway.app/";

const metrics = [
  { value: "<5ms", label: "Latencia de Inferencia", detail: "Microservicio REST FastAPI en tiempo real" },
  { value: "6M+", label: "Transacciones PaySim", detail: "Procesamiento distribuido en streaming" },
  { value: "100%", label: "PR-AUC en Test", detail: "Clasificador LightGBM balanceado" },
  { value: "38 / 38", label: "Tests Automatizados", detail: "Cobertura completa con Pytest" },
];

const medallionLayers = [
  {
    tier: "BRONZE",
    title: "Ingesta en Streaming & Parquet Inmutable",
    tech: "Redpanda (Kafka) + PyArrow",
    desc: "Ingesta distribuida desde el topic transactions.raw con particionado por cliente emisor (nameOrig) y commits síncronos con semántica at-least-once.",
  },
  {
    tier: "SILVER",
    title: "Motor Analítico & Feature Engineering",
    tech: "Polars (Rust Engine)",
    desc: "Deduplicación atómica por clave transaccional y cálculo masivo de ecuaciones contables de balance mediante evaluación perezosa (lazy), 15x más rápido que Pandas.",
  },
  {
    tier: "GOLD",
    title: "Scoring Híbrido & Perfil de Riesgo",
    tech: "LightGBM + Reglas Contables",
    desc: "Fusión ponderada 50/50: 0.5 * Reglas deterministas + 0.5 * Probabilidad ML, generando alertas de fraude categorizadas y perfiles KYC continuos.",
  },
];

const businessRules = [
  {
    id: "R1",
    score: "50 pts",
    name: "Inconsistencia Severa de Saldos",
    condition: "Discrepancia contable ≠ 0 en TRANSFER o CASH_OUT con montos ≥ $200,000.",
  },
  {
    id: "R2",
    score: "35 pts",
    name: "Transferencia a Cero Destino (Cuentas Mula)",
    condition: "Transferencias ≥ $200,000 hacia cuentas con saldo previo y posterior en cero.",
  },
  {
    id: "R3",
    score: "25 pts",
    name: "Ráfaga Operativa Anómala",
    condition: "≥ 2 transacciones de alto impacto de un mismo usuario dentro del mismo intervalo temporal.",
  },
];

const techStack = [
  { name: "Python 3.14+", category: "Lenguaje", detail: "Entorno moderno con tipado estricto y uv" },
  { name: "Redpanda", category: "Streaming", detail: "Broker de mensajería compatible con Apache Kafka" },
  { name: "Polars", category: "Data Engine", detail: "Motor DataFrame columnar en Rust de alta velocidad" },
  { name: "LightGBM", category: "Machine Learning", detail: "Gradient Boosting para datos tabulares asimétricos" },
  { name: "FastAPI", category: "Microservicio", detail: "API REST asíncrona con validación Pydantic v2 (<5ms)" },
  { name: "PyArrow", category: "Almacenamiento", detail: "Lectura/escritura optimizada de archivos Parquet" },
  { name: "Docker Compose", category: "DevOps", detail: "Contenerización de broker Redpanda y servicios" },
  { name: "Pytest", category: "Testing", detail: "Suite de 38 pruebas unitarias y de integración" },
];
---

<Layout
  title="Fintech Fraud Detection Platform | CodeJairo"
  description="Plataforma de detección de fraude financiero en streaming con arquitectura Lakehouse Medallion, Polars, Redpanda, LightGBM y FastAPI."
  ogImage={fraudPreview.src}
  ogType="article"
>
  <!-- Main con estética Cyber / Fintech Operations Center: dark slate, radar esmeralda y cian fosforescente -->
  <main class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-zinc-950 to-black text-zinc-100 transition-colors">
    <!-- Luces ambientales de radar -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="absolute -top-24 -left-20 w-88 h-88 rounded-full bg-emerald-500/15 blur-3xl animate-pulse"></div>
      <div class="absolute top-[35%] -right-24 w-88 h-88 rounded-full bg-cyan-500/15 blur-3xl"></div>
      <div class="absolute bottom-10 left-1/3 w-96 h-96 rounded-full bg-indigo-500/10 blur-3xl"></div>
    </div>

    <!-- 1. Hero Terminal de Monitoreo -->
    <section class="relative z-10 pt-32 pb-14 px-4 sm:px-8 lg:px-20 max-w-6xl mx-auto text-center">
      <div class="flex flex-wrap justify-center items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Streaming Lakehouse &amp; ML en Tiempo Real
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30">
          Python 3.14 · uv · Polars
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">
          Inferencia &lt;5ms
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
        Fintech Fraud Detection <br />
        <span class="bg-gradient-to-r from-emerald-400 via-cyan-400 to-indigo-400 bg-clip-text text-transparent">
          Platform
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-zinc-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Plataforma distribuida de prevención de fraude financiero en tiempo real. Procesa flujos de eventos sobre <strong class="text-white">6M+ de transacciones</strong> con Redpanda, reconciliación contable en memoria con <strong class="text-white">Polars</strong>, clasificación supervisada <strong class="text-white">LightGBM</strong> y evaluación REST en microsegundos.
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-wrap justify-center items-center gap-4 mb-12">
        <a
          href={LIVE_DEMO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-black font-bold hover:scale-105 transition-transform shadow-lg shadow-emerald-500/25 text-sm"
        >
          <span class="w-2 h-2 rounded-full bg-black animate-pulse"></span>
          <span>Probar Aplicación en Vivo (Railway)</span>
        </a>

        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-full border border-zinc-700 bg-zinc-900/80 text-zinc-200 hover:scale-105 font-bold transition-transform text-sm inline-flex items-center gap-2"
        >
          <span>Ver Repositorio GitHub</span>
        </a>
      </div>

      <!-- Ticker de Métricas de Inferencia -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto">
        {metrics.map((m) => (
          <div class="p-4 rounded-2xl bg-zinc-900/80 border border-zinc-800 text-left">
            <div class="text-2xl font-bold font-mono text-emerald-400">{m.value}</div>
            <div class="text-xs font-semibold text-white mt-0.5">{m.label}</div>
            <div class="text-[11px] text-zinc-400 mt-0.5">{m.detail}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Preview del Dashboard / Terminal -->
    <section class="relative z-10 py-6 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="rounded-2xl overflow-hidden border border-zinc-800 shadow-2xl bg-zinc-950">
        <Image
          src={fraudPreview}
          alt="Dashboard de monitoreo de fraude financiero y predicción de riesgo"
          class="w-full h-auto"
        />
      </div>
    </section>

    <!-- 2. Arquitectura Medallion en 3 Capas (Conciso) -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-5xl mx-auto border-t border-zinc-800/80">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400">Pipeline de Datos</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">
          Arquitectura Lakehouse Medallion
        </h2>
        <p class="text-sm text-zinc-400 mt-1 max-w-xl mx-auto">
          Ingesta, depuración columnar y scoring desacoplados para garantizar rendimiento continuo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {medallionLayers.map((layer) => (
          <div class="p-5 rounded-2xl bg-zinc-900/80 border border-zinc-800 flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-emerald-400">{layer.tier}</span>
              <h3 class="font-bold text-base text-white mt-1">{layer.title}</h3>
              <span class="text-xs font-mono text-cyan-400 mt-0.5 inline-block">{layer.tech}</span>
              <p class="text-xs text-zinc-300 leading-relaxed mt-2.5">{layer.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Motor Híbrido de Reglas Deterministas de Riesgo -->
    <section class="relative z-10 py-12 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="rounded-3xl border border-emerald-500/20 bg-zinc-900/90 p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-zinc-800 pb-4">
          <div>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">Gobernanza de Negocio</span>
            <h3 class="text-xl font-bold text-white mt-0.5">Motor de Scoring Híbrido (50 / 50)</h3>
          </div>
          <span class="self-start sm:self-center px-3 py-1 rounded-full text-xs font-mono bg-zinc-800 text-zinc-300 border border-zinc-700">
            Fórmula: 0.5 * Reglas + 0.5 * (Prob_ML * 100)
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {businessRules.map((rule) => (
            <div class="p-4 rounded-xl bg-zinc-950/70 border border-zinc-800 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-cyan-400">{rule.id}</span>
                  <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">{rule.score}</span>
                </div>
                <h4 class="font-bold text-xs sm:text-sm text-white mt-1.5">{rule.name}</h4>
                <p class="text-[11px] text-zinc-400 mt-1 leading-snug">{rule.condition}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Stack Técnico & Navegación -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-5xl mx-auto border-t border-zinc-800">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-white">Stack de Alto Rendimiento</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {techStack.map((t) => (
          <div class="p-3.5 rounded-xl bg-zinc-900/80 border border-zinc-800">
            <span class="text-[10px] font-mono text-cyan-400 font-semibold">{t.category}</span>
            <div class="font-bold text-sm text-white mt-0.5">{t.name}</div>
            <p class="text-xs text-zinc-400 mt-0.5">{t.detail}</p>
          </div>
        ))}
      </div>

      <div class="flex justify-between items-center pt-6 border-t border-zinc-800">
        <a
          href="/#proyectos"
          class="text-sm font-semibold text-zinc-400 hover:text-white transition-colors inline-flex items-center gap-1.5"
        >
          &larr; Volver a Proyectos
        </a>
        <a
          href="/projects/guardrail-api"
          class="text-sm font-semibold text-cyan-400 hover:underline inline-flex items-center gap-1.5"
        >
          Siguiente: Guardrail API &rarr;
        </a>
      </div>
    </section>
  </main>
</Layout>
