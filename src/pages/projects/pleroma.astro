---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import loginImage from "../../assets/pleroma/login.png";
import contractorFormImage from "../../assets/pleroma/contractor-form.png";
import cdpCreationImage from "../../assets/pleroma/cdp-creation.png";
import masterInfoImage from "../../assets/pleroma/master-info.png";
import auditsLogImage from "../../assets/pleroma/audits-log.png";
import documentGenerationImage from "../../assets/pleroma/document-generation.png";
import adminPanelImage from "../../assets/pleroma/admin-panel.png";

const principles = [
  {
    title: "Control documental",
    text: "Automatiza la salida de contratos y formatos para evitar edición manual repetitiva.",
  },
  {
    title: "Trazabilidad institucional",
    text: "Registra eventos críticos del proceso contractual para seguimiento y control interno.",
  },
  {
    title: "Estructura multi-tenant",
    text: "Permite segmentación por entidad con configuración y datos aislados.",
  },
];

const lifecycle = [
  {
    phase: "Fase 1",
    title: "Registro de terceros",
    detail: "Consolidación de información legal, bancaria y soporte contractual.",
  },
  {
    phase: "Fase 2",
    title: "Gestión presupuestal CDP",
    detail: "Control de disponibilidad y relación con rubros antes de comprometer contrato.",
  },
  {
    phase: "Fase 3",
    title: "Expediente contractual",
    detail: "Vinculación de contratista, supervisor, plazos y anexos normativos.",
  },
  {
    phase: "Fase 4",
    title: "Generación documental",
    detail: "Inyección automática de datos en plantillas Word institucionales.",
  },
  {
    phase: "Fase 5",
    title: "Auditoría",
    detail: "Bitácora de cambios con usuario, fecha y acción para trazabilidad.",
  },
];

const captures = [
  { title: "Acceso y roles", image: loginImage },
  { title: "Formulario de terceros", image: contractorFormImage },
  { title: "Creación de CDP", image: cdpCreationImage },
  { title: "Expediente contractual", image: masterInfoImage },
  { title: "Generación documental", image: documentGenerationImage },
  { title: "Auditoría", image: auditsLogImage },
  { title: "Panel administrativo", image: adminPanelImage },
];
---

<Layout
  title="Pleroma | Gestión de contratación pública"
  description="Pleroma: plataforma en construcción activa para trazabilidad de contratación pública, CDP, terceros y automatización documental."
>
  <main class="relative overflow-hidden bg-gradient-to-b from-indigo-50 via-white to-purple-50/70 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-20 left-[-8%] w-96 h-96 rounded-full bg-indigo-400/20 dark:bg-indigo-500/10 blur-3xl"></div>
      <div class="absolute top-[28%] right-[-10%] w-[28rem] h-[28rem] rounded-full bg-purple-400/20 dark:bg-purple-500/10 blur-3xl"></div>
      <div class="absolute bottom-[-7rem] left-[34%] w-[28rem] h-[28rem] rounded-full bg-cyan-400/20 dark:bg-cyan-500/10 blur-3xl"></div>
    </div>

    <section class="relative z-10 pt-28 pb-14 px-6 sm:px-10 lg:px-20" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 text-xs font-bold uppercase tracking-wide">
          Plataforma institucional
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          Construcción activa
        </div>

        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
          Pleroma
          <span class="block bg-gradient-to-r from-indigo-600 via-purple-500 to-cyan-500 bg-clip-text text-transparent">
            Orquestación contractual
          </span>
        </h1>

        <p class="mt-6 text-lg text-zinc-600 dark:text-zinc-300 max-w-3xl leading-relaxed">
          Sistema para estructurar procesos de contratación pública de punta a punta: terceros, disponibilidad presupuestal, expedientes y evidencia documental con trazabilidad.
        </p>
      </div>
    </section>

    <section class="relative z-10 py-12 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="70">
      <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-4">
        {principles.map((item) => (
          <article class="rounded-2xl border border-indigo-500/20 bg-white/85 dark:bg-zinc-900/70 p-5 shadow-sm">
            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">{item.title}</h2>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="relative z-10 py-12 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="90">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.05fr] gap-6 items-start">
        <article class="rounded-3xl border border-zinc-200 dark:border-zinc-700 bg-white/85 dark:bg-zinc-900/70 p-7">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Ciclo funcional que articula</h2>
          <ol class="mt-6 space-y-3.5">
            {lifecycle.map((step) => (
              <li class="rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900/75 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-indigo-600 dark:text-indigo-400">{step.phase}</p>
                <p class="font-semibold text-zinc-900 dark:text-white mt-1">{step.title}</p>
                <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1.5">{step.detail}</p>
              </li>
            ))}
          </ol>
        </article>

        <article class="rounded-3xl overflow-hidden border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900/70 shadow-sm">
          <Image src={masterInfoImage} alt="Expediente contractual en Pleroma" class="w-full h-full object-cover" />
        </article>
      </div>
    </section>

    <section class="relative z-10 py-12 pb-20 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="120">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mb-6">Pantallas clave del sistema</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {captures.map((item) => (
            <article class="group rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900/70">
              <div class="aspect-video overflow-hidden">
                <Image src={item.image} alt={item.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <p class="px-4 py-3 text-sm font-semibold text-zinc-700 dark:text-zinc-200">{item.title}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
