---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import loginImage from "../../assets/pleroma/login.png";
import contractorFormImage from "../../assets/pleroma/contractor-form.png";
import cdpCreationImage from "../../assets/pleroma/cdp-creation.png";
import masterInfoImage from "../../assets/pleroma/master-info.png";
import auditsLogImage from "../../assets/pleroma/audits-log.png";
import documentGenerationImage from "../../assets/pleroma/document-generation.png";
import adminPanelImage from "../../assets/pleroma/admin-panel.png";
import PleromaHero from "../../components/projects/pleroma/PleromaHero.astro";
import PleromaLearnings from "../../components/projects/pleroma/PleromaLearnings.astro";
import PleromaFooter from "../../components/projects/pleroma/PleromaFooter.astro";

const techStack = [
  { name: "Angular 21", category: "Frontend", description: "Arquitectura basada en componentes reactivos y señales" },
  { name: "TanStack Query", category: "Frontend", description: "Caché asíncrona, sincronización y mutaciones de estado" },
  { name: "TailwindCSS", category: "Frontend", description: "Diseño utilitario y sistema visual cohesivo" },
  { name: "Node.js", category: "Backend", description: "Servicios REST modulares y reglas de negocio" },
  { name: "Prisma ORM", category: "Backend", description: "Capa de acceso a base de datos con tipado estricto" },
  { name: "PostgreSQL", category: "Database", description: "Persistencia relacional con integridad referencial" },
  { name: "DocxTemplater", category: "Docs", description: "Generación automática de contratos Word (.docx)" },
  { name: "AWS S3 / MinIO", category: "Storage", description: "Almacenamiento en la nube para soportes y expedientes" },
  { name: "JWT + RBAC", category: "Auth", description: "Control de acceso granular por roles y permisos" },
  { name: "Docker", category: "DevOps", description: "Contenerización de entornos y despliegue reproducible" },
];

const challenges = [
  {
    title: "Generación manual de minutas",
    description: "Redacción propensa a errores tipográficos y desajustes legales en contratos y resoluciones.",
  },
  {
    title: "Control presupuestal fragmentado",
    description: "CDPs administrados en hojas de cálculo sin validación automática frente a los rubros disponibles.",
  },
  {
    title: "Expedientes dispersos",
    description: "Documentación de terceros y contratistas sin estructura unificada ni validación de requisitos.",
  },
  {
    title: "Falta de auditoría inmutable",
    description: "Ausencia de trazabilidad histórica sobre quién modificó cada contrato, rubro o fecha.",
  },
];

const screenshots = [
  {
    id: "login",
    title: "Acceso y Roles",
    description: "Autenticación segura con control de acceso granular por módulo",
    image: loginImage,
  },
  {
    id: "contractor-form",
    title: "Gestión de Terceros",
    description: "Formularios para personas naturales y jurídicas con validación legal",
    image: contractorFormImage,
  },
  {
    id: "cdp-creation",
    title: "Certificado Presupuestal (CDP)",
    description: "Asignación de rubros y cálculo automático de disponibilidad financiera",
    image: cdpCreationImage,
  },
  {
    id: "master-info",
    title: "Expediente Contractual",
    description: "Vinculación de CDP, contratista, supervisor, plazos y garantías",
    image: masterInfoImage,
  },
  {
    id: "document-generation",
    title: "Generador de Documentos",
    description: "Inyección automática de datos en plantillas Word (.docx) descargables",
    image: documentGenerationImage,
  },
  {
    id: "audits-log",
    title: "Registro de Auditoría",
    description: "Trazabilidad completa con usuario, fecha y detalle de cada cambio",
    image: auditsLogImage,
  },
  {
    id: "admin-panel",
    title: "Configuración Institucional",
    description: "Panel de administración y parámetros por entidad multi-tenant",
    image: adminPanelImage,
  },
];

const lifecycleStages = [
  {
    step: 1,
    name: "Registro de Tercero",
    tag: "Contratación",
    description: "Alta de persona natural o jurídica con validación automática de soportes legales y datos bancarios.",
    icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
    color: "indigo",
  },
  {
    step: 2,
    name: "Certificado Presupuestal (CDP)",
    tag: "Financiera",
    description: "Reserva de rubros presupuestales con cálculo automático de totales y verificación de fondos.",
    icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z",
    color: "purple",
  },
  {
    step: 3,
    name: "Expediente del Contrato",
    tag: "Jurídica",
    description: "Asociación del CDP con el contratista, definición de plazos, garantías y asignación de supervisor.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    color: "cyan",
  },
  {
    step: 4,
    name: "Generación Word (.docx)",
    tag: "Plataforma",
    description: "Inyección automática de datos en plantillas institucionales sin edición manual repetitiva.",
    icon: "M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z",
    color: "emerald",
  },
  {
    step: 5,
    name: "Auditoría & Resguardo S3",
    tag: "Control Interno",
    description: "Bitácora inmutable de eventos por usuario y resguardo de expedientes en almacenamiento cloud.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    color: "teal",
  },
];

const stageStyles = {
  indigo: { bg: "bg-indigo-500/10", border: "border-indigo-500/25", badge: "bg-indigo-500", text: "text-indigo-600 dark:text-indigo-400" },
  purple: { bg: "bg-purple-500/10", border: "border-purple-500/25", badge: "bg-purple-500", text: "text-purple-600 dark:text-purple-400" },
  cyan:   { bg: "bg-cyan-500/10", border: "border-cyan-500/25", badge: "bg-cyan-500", text: "text-cyan-600 dark:text-cyan-400" },
  emerald:{ bg: "bg-emerald-500/10", border: "border-emerald-500/25", badge: "bg-emerald-500", text: "text-emerald-600 dark:text-emerald-400" },
  teal:   { bg: "bg-teal-500/10", border: "border-teal-500/25", badge: "bg-teal-500", text: "text-teal-600 dark:text-teal-400" },
} as const;

const skills = [
  "Arquitectura frontend reactiva con Angular y TanStack Query",
  "Modelado relacional y restricciones de integridad en PostgreSQL",
  "Automatización documental con DocxTemplater y plantillas dinámicas",
  "Diseño de esquemas de seguridad con roles y permisos (RBAC)",
  "Sistemas de trazabilidad y bitácoras de auditoría de eventos",
  "Integración con almacenamiento cloud (AWS S3 / MinIO)",
];
---

<Layout
  title="Pleroma - Sistema de Gestión de Contratación Pública | CodeJairo"
  description="Sistema integral para la gestión de contratación pública colombiana. Angular, Node.js, PostgreSQL, AWS S3 y generación automatizada de documentos Word."
>
  <main
    class="relative overflow-hidden bg-gradient-to-b from-indigo-50 via-white to-purple-50/70 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950"
    x-data="{
      openModal: false,
      currentImage: null,
      currentTitle: '',
      currentDesc: '',
      openLightbox(img, title, desc) {
        this.currentImage = img;
        this.currentTitle = title;
        this.currentDesc = desc;
        this.openModal = true;
        document.body.style.overflow = 'hidden';
      },
      closeLightbox() {
        this.openModal = false;
        document.body.style.overflow = '';
      }
    }"
  >
    <!-- Background Gradient & Ambient Glow -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="absolute -top-28 -left-24 w-80 h-80 rounded-full bg-indigo-400/20 dark:bg-indigo-500/10 blur-3xl"></div>
      <div class="absolute top-[30%] -right-20 w-72 h-72 rounded-full bg-purple-400/20 dark:bg-purple-500/10 blur-3xl"></div>
      <div class="absolute bottom-[-6rem] left-1/3 w-96 h-96 rounded-full bg-cyan-400/20 dark:bg-cyan-500/10 blur-3xl"></div>
    </div>

    <!-- Hero Section -->
    <PleromaHero />

    <!-- El Problema -->
    <section class="relative z-10 py-12 md:py-16 lg:py-20 px-6 sm:px-12 lg:px-24 bg-transparent" data-aos="fade-up" data-aos-duration="420">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-sm font-bold text-indigo-500 uppercase tracking-wider">Contexto & Desafíos</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">
            El Problema
          </h2>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <p class="text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
              En las entidades de servicios públicos, los procesos contractuales solían depender de archivos dispersos, hojas de cálculo sin sincronización y elaboración manual de documentos Word propensa a desajustes legales.
            </p>
            <p class="text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
              <strong>Pleroma</strong> centraliza el ciclo contractual completo en una plataforma única, conectando la disponibilidad presupuestal (CDP), la validación de contratistas y la expedición automática de minutas contractuales.
            </p>
            <div class="p-5 bg-indigo-500/10 dark:bg-indigo-900/20 rounded-2xl border border-indigo-200 dark:border-indigo-800">
              <p class="text-indigo-900 dark:text-indigo-300 font-medium leading-relaxed">
                El objetivo central: erradicar el reproceso administrativo, asegurar el cumplimiento normativo colombiano y garantizar trazabilidad inmutable en cada contrato.
              </p>
            </div>
          </div>

          <div class="space-y-3">
            {challenges.map((item) => (
              <div class="flex items-start gap-4 p-4 bg-white dark:bg-zinc-800/80 rounded-2xl border border-zinc-200/80 dark:border-zinc-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-colors shadow-sm">
                <div class="w-9 h-9 shrink-0 rounded-xl bg-indigo-500/15 flex items-center justify-center mt-0.5">
                  <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-zinc-900 dark:text-white text-base">{item.title}</h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-0.5 leading-relaxed">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Divisor sutil con gradiente -->
    <div class="relative z-10 px-6 sm:px-12 -mt-1 mb-1" aria-hidden="true">
      <div class="mx-auto max-w-5xl opacity-60">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-indigo-500/40 to-transparent"></div>
      </div>
    </div>

    <!-- Galería Visual con Lightbox -->
    <section id="galeria" class="relative z-10 py-12 md:py-16 lg:py-20 px-6 sm:px-12 lg:px-24 bg-transparent" data-aos="fade-up" data-aos-duration="420">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-sm font-bold text-indigo-500 uppercase tracking-wider">Capturas del Sistema</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">
            Galería de la Aplicación
          </h2>
          <p class="text-lg text-zinc-600 dark:text-zinc-400 mt-3 max-w-2xl mx-auto">
            Explora las pantallas principales de la plataforma. Haz clic en cualquier imagen para abrirla en detalle.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {screenshots.map((screenshot) => (
            <div
              class="group relative overflow-hidden rounded-2xl bg-zinc-100 dark:bg-zinc-800 aspect-video cursor-pointer border border-zinc-200/80 dark:border-zinc-700 hover:border-indigo-500 dark:hover:border-indigo-400 transition-all duration-300 shadow-md hover:shadow-indigo-500/10"
              @click={`openLightbox('${screenshot.image.src}', '${screenshot.title}', '${screenshot.description}')`}
            >
              <Image
                src={screenshot.image}
                alt={screenshot.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />

              <!-- Hover overlay con icono de zoom -->
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-xs">
                <div class="text-center text-white p-4">
                  <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-white/20 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                    </svg>
                  </div>
                  <p class="text-xs font-semibold tracking-wider uppercase">Ampliar captura</p>
                </div>
              </div>

              <!-- Caption inferior -->
              <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/85 via-black/50 to-transparent">
                <p class="text-white font-bold text-sm">{screenshot.title}</p>
                <p class="text-white/75 text-xs truncate mt-0.5">{screenshot.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Divisor sutil con gradiente -->
    <div class="relative z-10 px-6 sm:px-12 -mt-1 mb-1" aria-hidden="true">
      <div class="mx-auto max-w-5xl opacity-60">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-purple-500/40 to-transparent"></div>
      </div>
    </div>

    <!-- Ciclo Contractual Conciso -->
    <section class="relative z-10 py-12 md:py-16 lg:py-20 px-6 sm:px-12 lg:px-24 bg-transparent" data-aos="fade-up" data-aos-duration="420">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-sm font-bold text-indigo-500 uppercase tracking-wider">Flujo de Trabajo</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">
            Ciclo de Gestión Contractual
          </h2>
          <p class="text-lg text-zinc-600 dark:text-zinc-400 mt-3 max-w-2xl mx-auto">
            El recorrido de extremo a extremo que garantiza validación presupuestal, rigor legal y trazabilidad en cada expediente.
          </p>
        </div>

        <!-- Pipeline en Desktop -->
        <div class="hidden lg:grid lg:grid-cols-5 gap-4 relative">
          {lifecycleStages.map((stage) => {
            const st = stageStyles[stage.color as keyof typeof stageStyles];
            return (
              <div class="flex flex-col bg-white dark:bg-zinc-800/90 rounded-2xl p-5 border border-zinc-200 dark:border-zinc-700/80 shadow-sm relative group hover:border-indigo-400 transition-all duration-300">
                <div class="flex items-center justify-between mb-4">
                  <span class={`w-8 h-8 rounded-xl ${st.badge} text-white flex items-center justify-center font-bold text-xs shadow-md`}>
                    0{stage.step}
                  </span>
                  <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider ${st.bg} ${st.text}`}>
                    {stage.tag}
                  </span>
                </div>

                <div class="mb-3">
                  <svg class={`w-6 h-6 ${st.text} mb-2`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stage.icon} />
                  </svg>
                  <h3 class="text-sm font-bold text-zinc-900 dark:text-white leading-snug">
                    {stage.name}
                  </h3>
                </div>

                <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mt-auto">
                  {stage.description}
                </p>
              </div>
            );
          })}
        </div>

        <!-- Pipeline en Móvil / Tablet -->
        <div class="lg:hidden flex flex-col gap-4">
          {lifecycleStages.map((stage, idx) => {
            const st = stageStyles[stage.color as keyof typeof stageStyles];
            const isLast = idx === lifecycleStages.length - 1;
            return (
              <div class="flex flex-col">
                <div class="flex items-start gap-4 p-4 rounded-2xl bg-white dark:bg-zinc-800/90 border border-zinc-200 dark:border-zinc-700 shadow-sm">
                  <div class={`w-10 h-10 shrink-0 rounded-xl ${st.badge} text-white flex items-center justify-center font-bold text-sm shadow-md`}>
                    0{stage.step}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-1">
                      <h3 class="text-sm font-bold text-zinc-900 dark:text-white truncate">
                        {stage.name}
                      </h3>
                      <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0 ${st.bg} ${st.text}`}>
                        {stage.tag}
                      </span>
                    </div>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                      {stage.description}
                    </p>
                  </div>
                </div>
                {!isLast && (
                  <div class="flex justify-center py-1">
                    <div class="w-0.5 h-3 bg-indigo-300 dark:bg-zinc-700"></div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Divisor sutil con gradiente -->
    <div class="relative z-10 px-6 sm:px-12 -mt-1 mb-1" aria-hidden="true">
      <div class="mx-auto max-w-5xl opacity-60">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-cyan-500/40 to-transparent"></div>
      </div>
    </div>

    <!-- Stack Técnico -->
    <section class="relative z-10 py-12 md:py-16 lg:py-20 px-6 sm:px-12 lg:px-24 bg-transparent" data-aos="fade-up" data-aos-duration="420">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-sm font-bold text-indigo-500 uppercase tracking-wider">Tecnologías & Arquitectura</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2">
            Stack Técnico
          </h2>
        </div>

        <div class="rounded-3xl border border-indigo-200/80 dark:border-indigo-800/60 bg-white/80 dark:bg-zinc-900/70 backdrop-blur-sm overflow-hidden shadow-sm">
          <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-indigo-100 dark:border-zinc-800 bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-cyan-500/10">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
            </div>
            <p class="text-[11px] sm:text-xs font-semibold tracking-[0.14em] text-zinc-600 dark:text-zinc-400 uppercase">
              stack://pleroma
            </p>
          </div>

          <div class="p-4 sm:p-5 md:p-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
              {techStack.map((tech, index) => (
                <article class="rounded-xl border border-indigo-200/70 dark:border-zinc-700 bg-white/90 dark:bg-zinc-800/70 px-4 py-3 hover:border-indigo-400 dark:hover:border-indigo-500 transition-colors">
                  <div class="flex items-center justify-between gap-2 mb-1.5">
                    <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-indigo-600 dark:text-indigo-400">{tech.category}</span>
                    <span class="text-[10px] font-semibold text-zinc-400 dark:text-zinc-500">{String(index + 1).padStart(2, '0')}</span>
                  </div>
                  <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 leading-snug">{tech.name}</h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">{tech.description}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Aprendizajes del Proyecto -->
    <PleromaLearnings skills={skills} />

    <!-- CTA y Footer del Proyecto -->
    <PleromaFooter />

    <!-- Modal Lightbox Global -->
    <div
      x-cloak
      x-show="openModal"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="closeLightbox()"
      @keydown.escape.window="closeLightbox()"
      class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/90 backdrop-blur-md p-4"
      style="display: none;"
    >
      <div class="relative max-w-5xl w-full max-h-[90vh]" @click.stop>
        <button
          @click="closeLightbox()"
          class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors z-10 cursor-pointer"
          aria-label="Cerrar modal"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="bg-zinc-900 rounded-2xl overflow-hidden flex items-center justify-center relative shadow-2xl border border-white/10">
          <template x-if="currentImage">
            <div class="w-full">
              <img
                :src="currentImage"
                :alt="currentTitle"
