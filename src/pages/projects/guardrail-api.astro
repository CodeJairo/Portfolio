---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const REPO_URL = "https://github.com/CodeJairo/guardrail-api";

const checks = [
  {
    category: "Autenticación",
    examples: [
      "Rutas sensibles sin requisitos claros de autenticación.",
      "Esquemas de seguridad inconsistentes entre operaciones.",
      "Permisos ambiguos en endpoints críticos.",
    ],
  },
  {
    category: "Validación de entrada",
    examples: [
      "Request bodies con restricciones insuficientes.",
      "Parámetros sin límites de formato o longitud.",
      "Contratos que abren superficies de abuso.",
    ],
  },
  {
    category: "Exposición de salida",
    examples: [
      "Respuestas con sobreexposición de campos internos.",
      "Estructuras no minimizadas para contexto público.",
      "Falta de controles explícitos de hardening en API.",
    ],
  },
];

const flow = [
  {
    step: "01",
    title: "Lectura de especificación",
    text: "Analiza archivo OpenAPI/Swagger como contrato fuente de seguridad.",
  },
  {
    step: "02",
    title: "Ejecución de reglas",
    text: "Aplica validaciones SAST/DAST orientadas a APIs en un solo flujo.",
  },
  {
    step: "03",
    title: "Reporte accionable",
    text: "Entrega hallazgos priorizados para corregir antes de despliegue.",
  },
];
---

<Layout
  title="Guardrail API | AppSec para OpenAPI"
  description="Guardrail API: paquete enfocado en revisión de seguridad sobre especificaciones OpenAPI/Swagger con enfoque SAST/DAST."
>
  <main class="relative overflow-hidden bg-gradient-to-b from-zinc-950 via-black to-zinc-900 text-zinc-100">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-20 left-[-10%] w-96 h-96 rounded-full bg-rose-500/20 blur-3xl"></div>
      <div class="absolute top-[28%] right-[-8%] w-[26rem] h-[26rem] rounded-full bg-amber-500/15 blur-3xl"></div>
      <div class="absolute bottom-[-8rem] left-[40%] w-[28rem] h-[28rem] rounded-full bg-red-500/10 blur-3xl"></div>
    </div>

    <section class="relative z-10 pt-28 pb-14 px-6 sm:px-10 lg:px-20" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-rose-400/30 bg-rose-500/10 text-rose-300 text-xs font-bold uppercase tracking-wide">
          AppSec Tooling
          <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
          API Security
        </div>

        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Guardrail API
          <span class="block bg-gradient-to-r from-rose-300 via-amber-300 to-red-300 bg-clip-text text-transparent">
            Seguridad preventiva para OpenAPI
          </span>
        </h1>

        <p class="mt-6 text-lg text-zinc-300 max-w-3xl leading-relaxed">
          Caso técnico centrado en detectar riesgos antes de producción a partir del contrato de una API. Diseñado para integrarse al flujo de trabajo de equipos backend y AppSec.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-rose-500 to-amber-500 text-white font-bold hover:scale-105 transition-transform">
            Ver repositorio
          </a>
          <a href="/#proyectos" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 text-white font-semibold hover:border-rose-300 transition-colors">
            Volver a proyectos
          </a>
        </div>
      </div>
    </section>

    <section class="relative z-10 py-12 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="70">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_0.9fr] gap-6">
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-7">
          <h2 class="text-2xl font-bold text-white">Flujo de análisis</h2>
          <div class="mt-6 space-y-3.5">
            {flow.map((item) => (
              <div class="rounded-2xl border border-rose-400/20 bg-rose-500/5 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-rose-300">Paso {item.step}</p>
                <p class="font-semibold text-white mt-1">{item.title}</p>
                <p class="text-sm text-zinc-300 mt-1.5">{item.text}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="rounded-3xl border border-amber-400/20 bg-amber-500/10 p-7">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-300">Objetivo del proyecto</p>
          <h3 class="text-2xl font-bold text-white mt-2">Reducir riesgo temprano</h3>
          <p class="mt-4 text-sm text-zinc-200 leading-relaxed">
            El enfoque no es solo listar problemas, sino facilitar decisiones de corrección antes de que una API llegue a un entorno crítico.
          </p>
        </article>
      </div>
    </section>

    <section class="relative z-10 py-12 pb-20 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="110">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold">Dominios de hallazgo</h2>
        <div class="mt-6 grid md:grid-cols-3 gap-4">
          {checks.map((domain) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
              <h3 class="text-lg font-bold text-white">{domain.category}</h3>
              <ul class="mt-3 space-y-2 text-sm text-zinc-300">
                {domain.examples.map((example) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-rose-400 shrink-0"></span>
                    <span>{example}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
