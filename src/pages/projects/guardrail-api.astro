---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import guardrailPreview from "../../assets/guardrail/guardrail-preview.svg";

const GITHUB_REPO_URL = "https://github.com/CodeJairo/guardrail-api";

const metrics = [
  { value: "<300ms", label: "Tiempo de Arranque", detail: "Arranque instantáneo en runners de CI" },
  { value: "SARIF 2.1.0", label: "Estándar de Seguridad", detail: "Integración con GitHub Code Scanning" },
  { value: "100%", label: "TypeScript & ESM", detail: "Tipado estricto sin dependencias pesadas" },
  { value: "Vitest", label: "Suite Automatizada", detail: "Tests de esquemas y probes HTTP" },
];

const enginePillars = [
  {
    step: "01",
    tier: "SAST",
    title: "Análisis Estático OpenAPI",
    tech: "Swagger Parser",
    desc: "Inspecciona contratos OpenAPI 3.0 y Swagger (JSON/YAML) desreferenciando esquemas ($ref) para detectar endpoints sin autenticación o parámetros sin tipado.",
  },
  {
    step: "02",
    tier: "DAST",
    title: "Probes Dinámicos Activos",
    tech: "Axios Probes No Destructivos",
    desc: "Emite peticiones HTTP dirigidas a la API en vivo para verificar respuestas 401/403 en rutas privadas, validar headers de seguridad (HSTS, CSP) y CORS permisivo (*).",
  },
  {
    step: "03",
    tier: "CI/CD",
    title: "Compuerta de Calidad & SARIF",
    tech: "SARIF 2.1.0 + Exit Codes",
    desc: "Permite definir umbrales de error (--fail-on high) retornando exit code 1 para bloquear pipelines de despliegue antes de exponer vulnerabilidades en producción.",
  },
];

const owaspRules = [
  { id: "API1:2023", name: "Broken Object Level Authorization (BOLA)", check: "Auditoría de patrones en IDs de ruta y ausencia de esquemas de autorización." },
  { id: "API2:2023", name: "Broken Authentication", check: "Probes activos verificando rechazo 401 sin credenciales en endpoints protegidos." },
  { id: "API7:2023", name: "Server-Side Request Forgery & Injections", check: "Fuzzing de tipos esperando rechazo 400 Bad Request en lugar de caídas 500." },
  { id: "API8:2023", name: "Security Misconfiguration", check: "Detección de cabeceras HSTS/CSP ausentes y Access-Control-Allow-Origin: * con credenciales." },
];

const techStack = [
  { name: "TypeScript 5.7", category: "Lenguaje", detail: "Tipado estricto en el motor de análisis" },
  { name: "Node.js (ESM)", category: "Runtime", detail: "Módulos ECMAScript nativos de alto rendimiento" },
  { name: "Commander.js", category: "CLI", detail: "Gestión de flags y argumentos de terminal" },
  { name: "Swagger Parser", category: "Parser", detail: "Resolución y validación de contratos OpenAPI" },
  { name: "Axios", category: "HTTP", detail: "Peticiones dinámicas no destructivas contra endpoints" },
  { name: "Vitest", category: "Testing", detail: "Suite de pruebas unitarias y de integración" },
  { name: "SARIF 2.1.0", category: "Estándar", detail: "Formato oficial para GitHub Security Tabs" },
  { name: "cli-table3", category: "Terminal UI", detail: "Renderizado limpio y coloreado en consola" },
];
---

<Layout
  title="Guardrail API - CLI & Auditoría de Seguridad de APIs | CodeJairo"
  description="Herramienta de línea de comandos y paquete npm para auditar seguridad en APIs mediante análisis estático de OpenAPI y probes dinámicos (DAST) con reporte SARIF."
>
  <!-- Main con estética DevSecOps / Hacker Minimalist Terminal: negro carbón, verde terminal y ámbar -->
  <main class="relative overflow-hidden bg-gradient-to-b from-zinc-950 via-zinc-900 to-black text-zinc-100 transition-colors">
    <!-- Luces ambientales de consola -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="absolute -top-24 -left-20 w-88 h-88 rounded-full bg-emerald-500/10 blur-3xl animate-pulse"></div>
      <div class="absolute top-[35%] -right-24 w-88 h-88 rounded-full bg-cyan-500/10 blur-3xl"></div>
      <div class="absolute bottom-10 left-1/3 w-96 h-96 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <!-- 1. Hero Terminal CLI -->
    <section class="relative z-10 pt-32 pb-14 px-4 sm:px-8 lg:px-20 max-w-6xl mx-auto text-center">
      <div class="flex flex-wrap justify-center items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Open Source CLI &amp; npm Package
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30">
          OpenAPI 3.0 · DAST &amp; SAST
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-amber-500/15 text-amber-400 border border-amber-500/30">
          SARIF 2.1.0 Ready
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
        Guardrail API <br />
        <span class="bg-gradient-to-r from-emerald-400 via-cyan-400 to-blue-500 bg-clip-text text-transparent">
          Auditoría de Seguridad en APIs
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-zinc-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Herramienta de línea de comandos para desarrolladores backend y pipelines de CI/CD. Combina linting de contratos <strong class="text-white">OpenAPI</strong> contra fallos <strong class="text-white">OWASP API Security</strong> con <strong class="text-white">probes dinámicos en vivo</strong> para prevenir fugas de seguridad antes del despliegue.
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-wrap justify-center items-center gap-4 mb-12">
        <a
          href={GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-black font-bold hover:scale-105 transition-transform shadow-lg shadow-emerald-500/20 text-sm"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span>Ver Repositorio GitHub</span>
        </a>

        <div class="px-5 py-3 rounded-full border border-zinc-700 bg-zinc-900/90 text-zinc-300 font-mono text-xs flex items-center gap-2">
          <span class="text-emerald-400 font-bold">$</span>
          <span>pnpm link --global</span>
        </div>
      </div>

      <!-- Ticker de Métricas de la CLI -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto">
        {metrics.map((m) => (
          <div class="p-4 rounded-2xl bg-zinc-900/80 border border-zinc-800 text-left">
            <div class="text-2xl font-bold font-mono text-emerald-400">{m.value}</div>
            <div class="text-xs font-semibold text-white mt-0.5">{m.label}</div>
            <div class="text-[11px] text-zinc-400 mt-0.5">{m.detail}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Preview Gráfico de la Terminal -->
    <section class="relative z-10 py-6 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="rounded-2xl overflow-hidden border border-zinc-800 shadow-2xl bg-black">
        <Image
          src={guardrailPreview}
          alt="Auditoría de seguridad con Guardrail API mostrando hallazgos y reporte SARIF"
          class="w-full h-auto"
        />
      </div>
    </section>

    <!-- 2. Arquitectura del Motor Híbrido (Conciso) -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-5xl mx-auto border-t border-zinc-800/80">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400">Arquitectura de Análisis</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">
          Motor Híbrido: Linting + Probes Activos
        </h2>
        <p class="text-sm text-zinc-400 mt-1 max-w-xl mx-auto">
          Inspección estática de contratos y validación activa sin sobrecargar la red ni corromper datos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {enginePillars.map((p) => (
          <div class="p-5 rounded-2xl bg-zinc-900/80 border border-zinc-800 flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-emerald-400">{p.tier}</span>
              <h3 class="font-bold text-base text-white mt-1">{p.title}</h3>
              <span class="text-xs font-mono text-cyan-400 mt-0.5 inline-block">{p.tech}</span>
              <p class="text-xs text-zinc-300 leading-relaxed mt-2.5">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Cobertura OWASP API Security (Compacta) -->
    <section class="relative z-10 py-12 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="rounded-3xl border border-zinc-800 bg-zinc-900/90 p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-zinc-800 pb-4">
          <div>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">Estándar de Seguridad</span>
            <h3 class="text-xl font-bold text-white mt-0.5">Cobertura OWASP API Security Top 10</h3>
          </div>
          <span class="self-start sm:self-center px-3 py-1 rounded-full text-xs font-mono bg-zinc-800 text-zinc-300 border border-zinc-700">
            Exportación SARIF 2.1.0 Nativa
          </span>
        </div>

        <div class="space-y-3">
          {owaspRules.map((rule) => (
            <div class="p-3.5 rounded-xl bg-zinc-950/70 border border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono font-bold text-emerald-400">{rule.id}</span>
                  <span class="text-xs sm:text-sm font-semibold text-white">{rule.name}</span>
                </div>
                <p class="text-xs text-zinc-400">{rule.check}</p>
              </div>
              <span class="shrink-0 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700 self-start sm:self-auto">
                Automatizado
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Stack Técnico & Navegación -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-5xl mx-auto border-t border-zinc-800">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-white">Stack de la CLI</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {techStack.map((t) => (
          <div class="p-3.5 rounded-xl bg-zinc-900/80 border border-zinc-800">
            <span class="text-[10px] font-mono text-cyan-400 font-semibold">{t.category}</span>
            <div class="font-bold text-sm text-white mt-0.5">{t.name}</div>
            <p class="text-xs text-zinc-400 mt-0.5">{t.detail}</p>
          </div>
        ))}
      </div>

      <div class="flex justify-between items-center pt-6 border-t border-zinc-800">
        <a
          href="/#proyectos"
          class="text-sm font-semibold text-zinc-400 hover:text-white transition-colors inline-flex items-center gap-1.5"
        >
          &larr; Volver a Proyectos
        </a>
        <a
          href="/projects/higinex"
          class="text-sm font-semibold text-emerald-400 hover:underline inline-flex items-center gap-1.5"
        >
          Siguiente: Higinex &rarr;
        </a>
      </div>
    </section>
  </main>
</Layout>
