---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import catalogImage from "../../assets/higinex/catalog.png";
import cartImage from "../../assets/higinex/cart.png";
import checkoutImage from "../../assets/higinex/checkout.png";
import adminDashboardImage from "../../assets/higinex/admin-dashboard.png";
import adminOrdersImage from "../../assets/higinex/admin-orders.png";
import orderConfirmedImage from "../../assets/higinex/order-confirmed.png";

const FRONT_REPO = "https://github.com/CodeJairo/higinex-front";
const BACK_REPO = "https://github.com/CodeJairo/higinex-back";

const pillars = [
  {
    title: "Catálogo por cliente",
    detail: "Productos y precios según negociación comercial B2B.",
  },
  {
    title: "Pedido trazable",
    detail: "Del carrito al estado final con visibilidad para cliente y operación.",
  },
  {
    title: "Operación centralizada",
    detail: "Panel administrativo para control de inventario y gestión de órdenes.",
  },
];

const flow = [
  {
    title: "Explorar catálogo",
    text: "El cliente consulta referencias, disponibilidad y condiciones comerciales.",
  },
  {
    title: "Armar pedido",
    text: "Selecciona cantidades, valida stock y confirma la orden.",
  },
  {
    title: "Procesar internamente",
    text: "El equipo administrativo recibe, verifica y prepara despacho.",
  },
  {
    title: "Cerrar entrega",
    text: "El pedido cambia de estado hasta confirmación final.",
  },
];

const gallery = [
  { title: "Catálogo", image: catalogImage },
  { title: "Carrito", image: cartImage },
  { title: "Checkout", image: checkoutImage },
  { title: "Pedido confirmado", image: orderConfirmedImage },
  { title: "Dashboard admin", image: adminDashboardImage },
  { title: "Gestión de órdenes", image: adminOrdersImage },
];
---

<Layout
  title="Higinex | Ecommerce B2B de aseo"
  description="Higinex: ecommerce B2B para distribución de productos de aseo con flujo comercial y operación administrativa unificada."
>
  <main class="relative overflow-hidden bg-gradient-to-b from-emerald-50 via-white to-teal-50/70 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-emerald-400/20 dark:bg-emerald-500/10 blur-3xl"></div>
      <div class="absolute top-[28%] -right-20 w-72 h-72 rounded-full bg-teal-400/20 dark:bg-teal-500/10 blur-3xl"></div>
      <div class="absolute bottom-[-7rem] left-[36%] w-96 h-96 rounded-full bg-cyan-400/20 dark:bg-cyan-500/10 blur-3xl"></div>
    </div>

    <section class="relative z-10 pt-28 pb-14 px-6 sm:px-10 lg:px-20" data-aos="fade-up">
      <div class="max-w-6xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase tracking-wide">
          Ecommerce B2B
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Producto vendido
        </div>

        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
          Higinex
          <span class="block bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500 bg-clip-text text-transparent">
            Distribución comercial digital
          </span>
        </h1>

        <p class="mt-6 text-lg text-zinc-600 dark:text-zinc-300 max-w-3xl leading-relaxed">
          Plataforma diseñada para ordenar la venta mayorista de productos de aseo: catálogo por cliente, pedidos trazables y gestión operativa en una sola interfaz.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={FRONT_REPO} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-bold hover:scale-105 transition-transform">
            Frontend
          </a>
          <a href={BACK_REPO} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold hover:border-zinc-900 dark:hover:border-white transition-colors">
            Backend
          </a>
        </div>
      </div>
    </section>

    <section class="relative z-10 py-12 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="70">
      <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-4">
        {pillars.map((pillar) => (
          <article class="rounded-2xl border border-emerald-500/20 bg-white/85 dark:bg-zinc-900/70 p-5 shadow-sm">
            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">{pillar.title}</h2>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{pillar.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="relative z-10 py-12 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="90">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.1fr] gap-6 items-start">
        <article class="rounded-3xl border border-zinc-200 dark:border-zinc-700 bg-white/85 dark:bg-zinc-900/70 p-7">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Flujo comercial que resuelve</h2>
          <p class="mt-4 text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Higinex conecta la experiencia de compra del cliente con la ejecución operativa interna para reducir fricción en pedidos B2B.
          </p>

          <ol class="mt-6 space-y-3.5">
            {flow.map((step, index) => (
              <li class="rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900/70 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-emerald-600 dark:text-emerald-400">Paso {index + 1}</p>
                <p class="font-semibold text-zinc-900 dark:text-white mt-1">{step.title}</p>
                <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1.5">{step.text}</p>
              </li>
            ))}
          </ol>
        </article>

        <article class="rounded-3xl overflow-hidden border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900/70 shadow-sm">
          <Image src={catalogImage} alt="Catálogo de Higinex" class="w-full h-full object-cover" />
        </article>
      </div>
    </section>

    <section class="relative z-10 py-12 pb-20 px-6 sm:px-10 lg:px-20" data-aos="fade-up" data-aos-delay="120">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mb-6">Galería funcional del producto</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {gallery.map((item) => (
            <article class="group rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900/70">
              <div class="aspect-video overflow-hidden">
                <Image src={item.image} alt={item.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <p class="px-4 py-3 text-sm font-semibold text-zinc-700 dark:text-zinc-200">{item.title}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
