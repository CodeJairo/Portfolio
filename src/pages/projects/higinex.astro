---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import loginImage from "../../assets/higinex/login.png";
import catalogImage from "../../assets/higinex/catalog.png";
import mobileImage from "../../assets/higinex/mobile.png";
import cartImage from "../../assets/higinex/cart.png";
import checkoutImage from "../../assets/higinex/checkout.png";
import orderConfirmedImage from "../../assets/higinex/order-confirmed.png";
import adminDashboardImage from "../../assets/higinex/admin-dashboard.png";
import adminOrdersImage from "../../assets/higinex/admin-orders.png";
import emailImage from "../../assets/higinex/email.png";

const techStack = [
  { name: "Angular 21", category: "Frontend", detail: "Componentes reactivos e interfaz de usuario" },
  { name: "TanStack Query", category: "Frontend", detail: "Caché asíncrona y sincronización de catálogo" },
  { name: "NestJS 10", category: "Backend", detail: "Arquitectura modular y lógica de pedidos" },
  { name: "Prisma ORM", category: "Backend", detail: "Acceso a base de datos con tipado estricto" },
  { name: "PostgreSQL", category: "Database", detail: "Persistencia transaccional con integridad ACID" },
  { name: "TailwindCSS", category: "UI", detail: "Sistema de diseño comercial limpio y responsive" },
  { name: "SendGrid", category: "Email", detail: "Notificaciones transaccionales automáticas" },
  { name: "Netlify & Render", category: "Deploy", detail: "Despliegue continuo de frontend y API" },
];

const pillars = [
  {
    title: "Tarifas Negociadas por Cliente",
    desc: "Cada comprador accede a su lista de precios pactada según volumen de compra, eliminando hojas de cálculo externas.",
  },
  {
    title: "Reserva de Stock en Tiempo Real",
    desc: "Validación atómica de inventario al crear la orden para evitar despachos duplicados o quiebres de existencias.",
  },
  {
    title: "Panel Operativo Centralizado",
    desc: "El equipo de logística gestiona pedidos, aprueba despachos y notifica al cliente desde un único tablero.",
  },
];

const flowSteps = [
  { step: "01", name: "Catálogo Personalizado", desc: "Navegación con precios según perfil del cliente autorizado." },
  { step: "02", name: "Carrito Persistente", desc: "Resumen de compra y verificación inmediata de existencias." },
  { step: "03", name: "Checkout & Despacho", desc: "Selección de dirección de entrega y registro del pedido." },
  { step: "04", name: "Confirmación Automática", desc: "Envío de email transaccional al cliente y alerta logística." },
  { step: "05", name: "Gestión de Entrega", desc: "Actualización de estado en ruta y control de entrega final." },
];

const screenshots = [
  { id: "login", title: "Landing / Acceso", description: "Portal corporativo con autenticación segura", image: loginImage },
  { id: "catalog", title: "Catálogo de Productos", description: "Búsqueda y filtros con precios asignados al cliente", image: catalogImage },
  { id: "cart", title: "Carrito de Compras", description: "Resumen del pedido con cálculo automático de totales", image: cartImage },
  { id: "checkout", title: "Checkout", description: "Confirmación de entrega y condiciones de pago", image: checkoutImage },
  { id: "order-confirmed", title: "Pedido Confirmado", description: "Comprobante de compra con estado de preparación", image: orderConfirmedImage },
  { id: "admin-dashboard", title: "Panel Administrativo", description: "Métricas de ventas, pedidos y clientes activos", image: adminDashboardImage },
  { id: "admin-orders", title: "Gestión de Pedidos", description: "Control y cambio de estados logísticos en tiempo real", image: adminOrdersImage },
  { id: "email", title: "Email Transaccional", description: "Notificación automática al comprador", image: emailImage },
  { id: "mobile", title: "Vista Móvil", description: "Diseño 100% responsivo para compras en terreno", image: mobileImage },
];
---

<Layout
  title="Higinex - E-commerce B2B de Aseo e Higiene | CodeJairo"
  description="Plataforma de comercio electrónico B2B desarrollada y comercializada para distribución de productos de aseo. Angular, NestJS, PostgreSQL."
>
  <!-- Main con estética fresca de aseo y limpieza: verde menta, esmeralda y cian cristalino -->
  <main
    class="relative overflow-hidden bg-gradient-to-b from-emerald-50/70 via-white to-teal-50/50 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors"
    x-data="{
      openModal: false,
      currentImage: null,
      currentTitle: '',
      currentDesc: '',
      openLightbox(img, title, desc) {
        this.currentImage = img;
        this.currentTitle = title;
        this.currentDesc = desc;
        this.openModal = true;
        document.body.style.overflow = 'hidden';
      },
      closeLightbox() {
        this.openModal = false;
        document.body.style.overflow = '';
      }
    }"
  >
    <!-- Efecto ambiental: burbujas y gradientes sutiles de limpieza -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="absolute -top-24 -left-20 w-80 h-80 rounded-full bg-emerald-400/20 dark:bg-emerald-500/10 blur-3xl animate-pulse"></div>
      <div class="absolute top-[35%] -right-24 w-88 h-88 rounded-full bg-teal-400/20 dark:bg-teal-500/10 blur-3xl"></div>
      <div class="absolute bottom-10 left-1/4 w-96 h-96 rounded-full bg-cyan-400/15 dark:bg-cyan-500/10 blur-3xl"></div>
    </div>

    <!-- 1. Hero Temático Aseo & Higiene B2B -->
    <section class="relative z-10 pt-32 pb-16 px-4 sm:px-8 lg:px-20 max-w-6xl mx-auto text-center">
      <!-- Badges de Estado -->
      <div class="flex flex-wrap justify-center items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Proyecto Comercializado &amp; Desplegado
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-teal-500/15 text-teal-800 dark:text-teal-300 border border-teal-500/30">
          Distribución de Aseo &amp; Desinfección
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-cyan-500/15 text-cyan-800 dark:text-cyan-300 border border-cyan-500/30">
          Arquitectura B2B Modular
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
        Higinex <br />
        <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400 bg-clip-text text-transparent">
          E-commerce B2B de Productos de Aseo
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Plataforma comercial desarrollada y transferida exitosamente a una distribuidora de productos de aseo e higiene institucional. Digitalizó el ciclo completo de pedidos: tarifas personalizadas, inventario en tiempo real y despacho coordinado.
      </p>

      <!-- Botones de Acción Directa -->
      <div class="flex flex-wrap justify-center items-center gap-4">
        <a
          href="https://higinex.netlify.app"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-bold hover:scale-105 transition-transform shadow-lg shadow-emerald-500/25 text-sm"
        >
          <span>Ver Plataforma en Vivo</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>

        <a
          href="https://github.com/CodeJairo/higinex-front"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-3.5 rounded-full border border-zinc-300 dark:border-zinc-700 bg-white/80 dark:bg-zinc-900/80 text-zinc-800 dark:text-zinc-200 hover:scale-105 font-bold transition-transform text-sm inline-flex items-center gap-2"
        >
          <span>Frontend Repo</span>
        </a>

        <a
          href="https://github.com/CodeJairo/higinex-back"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-3.5 rounded-full border border-zinc-300 dark:border-zinc-700 bg-white/80 dark:bg-zinc-900/80 text-zinc-800 dark:text-zinc-200 hover:scale-105 font-bold transition-transform text-sm inline-flex items-center gap-2"
        >
          <span>Backend Repo</span>
        </a>
      </div>
    </section>

    <!-- 2. Contexto & Pilares de Valor (Conciso) -->
    <section class="relative z-10 py-12 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="rounded-3xl border border-emerald-500/20 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md p-6 sm:p-10 shadow-sm space-y-8">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Contexto Operativo</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mt-1">
            De la Gestión Dispersa a la Venta B2B Automatizada
          </h2>
          <p class="text-zinc-600 dark:text-zinc-300 text-sm sm:text-base leading-relaxed mt-2">
            La distribuidora gestionaba sus ventas mediante canales informales de chat y hojas de cálculo desactualizadas, provocando errores en precios por volumen y pedidos sobre productos sin existencias en bodega. Higinex estructuró la operación bajo 3 pilares clave:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {pillars.map((item, i) => (
            <div class="p-5 rounded-2xl bg-emerald-500/5 dark:bg-zinc-800/60 border border-emerald-500/15 flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">0{i + 1}</span>
                <h3 class="font-bold text-base text-zinc-900 dark:text-white mt-1">{item.title}</h3>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Flujo Logístico del Pedido -->
    <section class="relative z-10 py-12 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">Ciclo Comercial B2B</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mt-1">
          Flujo de Pedido &amp; Despacho
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        {flowSteps.map((step) => (
          <div class="p-4 rounded-2xl bg-white/70 dark:bg-zinc-900/70 border border-zinc-200 dark:border-zinc-800 text-left flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-teal-600 dark:text-teal-400">{step.step}</span>
              <h4 class="font-bold text-xs sm:text-sm text-zinc-900 dark:text-white mt-1">{step.name}</h4>
              <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 leading-snug">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Galería Completa de Capturas (Todas las 9 imágenes con Lightbox) -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-6xl mx-auto border-t border-zinc-200/80 dark:border-zinc-800/80">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Evidencia del Sistema</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mt-1">
          Galería de la Aplicación
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Haz clic en cualquier captura para inspeccionar la interfaz en detalle.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {screenshots.map((s) => (
          <button
            type="button"
            @click={`openLightbox('${s.image.src}', '${s.title}', '${s.description}')`}
            class="group text-left rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm hover:shadow-md hover:border-emerald-500/40 transition-all cursor-pointer"
          >
            <div class="w-full h-44 overflow-hidden bg-zinc-100 dark:bg-zinc-800 relative">
              <Image
                src={s.image}
                alt={s.title}
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-emerald-500/0 group-hover:bg-emerald-500/10 transition-colors"></div>
            </div>
            <div class="p-3.5">
              <h4 class="font-bold text-sm text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {s.title}
              </h4>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 line-clamp-1">{s.description}</p>
            </div>
          </button>
        ))}
      </div>
    </section>

    <!-- 5. Ficha Técnica & Navegación -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-5xl mx-auto border-t border-zinc-200/80 dark:border-zinc-800/80">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Stack de Producción</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {techStack.map((t) => (
          <div class="p-3.5 rounded-xl bg-white/60 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
            <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold">{t.category}</span>
            <div class="font-bold text-sm text-zinc-900 dark:text-white mt-0.5">{t.name}</div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{t.detail}</p>
          </div>
        ))}
      </div>

      <div class="flex justify-between items-center pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <a
          href="/#proyectos"
          class="text-sm font-semibold text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"
        >
          &larr; Volver a Proyectos
        </a>
        <a
          href="/projects/esp-contrata"
          class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1.5"
        >
          Siguiente: ESP Contrata &rarr;
        </a>
      </div>
    </section>

    <!-- Modal Lightbox (Alpine.js) -->
    <div
      x-cloak
      x-show="openModal"
      x-transition.opacity
      @keydown.escape.window="closeLightbox()"
      class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 sm:p-6"
      style="display: none;"
    >
      <div
        @click.away="closeLightbox()"
        class="relative max-w-4xl w-full bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl"
      >
        <div class="p-4 bg-zinc-900 border-b border-zinc-800 flex items-center justify-between">
          <div>
            <h4 class="font-bold text-white text-sm" x-text="currentTitle"></h4>
            <p class="text-xs text-zinc-400" x-text="currentDesc"></p>
          </div>
          <button
            @click="closeLightbox()"
            class="text-zinc-400 hover:text-white text-xs px-2.5 py-1 rounded bg-zinc-800 transition-colors"
          >
            Cerrar [ESC]
          </button>
        </div>
        <div class="p-2 sm:p-4 max-h-[75vh] overflow-auto flex items-center justify-center bg-black">
          <img :src="currentImage" :alt="currentTitle" class="max-w-full max-h-[70vh] object-contain rounded" />
        </div>
      </div>
    </div>
  </main>
</Layout>