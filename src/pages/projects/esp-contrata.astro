---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";
import loginImage from "../../assets/pleroma/login.png";
import contractorFormImage from "../../assets/pleroma/contractor-form.png";
import cdpCreationImage from "../../assets/pleroma/cdp-creation.png";
import masterInfoImage from "../../assets/pleroma/master-info.png";
import auditsLogImage from "../../assets/pleroma/audits-log.png";
import adminPanelImage from "../../assets/pleroma/admin-panel.png";
import pleromaPreview from "../../assets/pleroma/pleroma-preview.png";

const techStack = [
  { name: "Angular 21", category: "Frontend", detail: "Interfaz modular y formularios reactivos tipados" },
  { name: "TanStack Query", category: "Frontend", detail: "Sincronización de expedientes y mutaciones de estado" },
  { name: "Node.js (ESM)", category: "Backend", detail: "Servicios REST con reglas de negocio contractuales" },
  { name: "Prisma ORM", category: "Backend", detail: "Capa de acceso a base de datos con tipado estricto" },
  { name: "PostgreSQL", category: "Database", detail: "Persistencia relacional con integridad referencial" },
  { name: "AWS S3 / MinIO", category: "Storage", detail: "Almacenamiento seguro en la nube para expedientes" },
  { name: "JWT + RBAC", category: "Seguridad", detail: "Control de acceso granular por rol institucional" },
  { name: "Docker", category: "DevOps", detail: "Contenerización de entornos y despliegue reproducible" },
];

const legalPillars = [
  {
    title: "Certificado de Disponibilidad (CDP)",
    desc: "Reserva automática de rubros presupuestales que impide comprometer saldos inexistentes antes de adjudicar el contrato.",
  },
  {
    title: "Expediente Único de Contratistas",
    desc: "Validación y archivo centralizado de documentos legales, certificaciones bancarias y soportes fiscales de personas naturales y jurídicas.",
  },
  {
    title: "Trazabilidad Forense de Auditoría",
    desc: "Bitácora inmutable que estampa usuario, fecha y valor previo de cualquier modificación contractual para control de órganos de vigilancia.",
  },
];

const contractStages = [
  { step: "01", name: "Registro de Terceros", desc: "Alta y validación de antecedentes del contratista." },
  { step: "02", name: "Expedición del CDP", desc: "Verificación de saldo y reserva presupuestal vinculante." },
  { step: "03", name: "Expediente Contractual", desc: "Definición de garantías, pólizas, supervisor y plazos." },
  { step: "04", name: "Auditoría & Resguardo", desc: "Sellado de la minuta y resguardo inmutable en almacenamiento S3." },
];

// Se eliminó la captura de Generador de Documentos según instrucción explícita del usuario
const screenshots = [
  { id: "login", title: "Acceso Institucional & Roles", description: "Autenticación segura con control de permisos RBAC", image: loginImage },
  { id: "contractor-form", title: "Gestión de Terceros", description: "Formulario de vinculación legal con validación de requisitos", image: contractorFormImage },
  { id: "cdp-creation", title: "Certificado Presupuestal (CDP)", description: "Asignación de rubros y control de disponibilidad financiera", image: cdpCreationImage },
  { id: "master-info", title: "Expediente del Contrato", description: "Vinculación de contratista, CDP, plazos y supervisión", image: masterInfoImage },
  { id: "audits-log", title: "Registro de Auditoría", description: "Bitácora inmutable de eventos por usuario y fecha", image: auditsLogImage },
  { id: "admin-panel", title: "Configuración Institucional", description: "Panel multi-tenant para parámetros de la entidad", image: adminPanelImage },
];
---

<Layout
  title="ESP Contrata - Sistema de Gestión de Contratación Pública | CodeJairo"
  description="Plataforma institucional para la gestión contractual, certificación presupuestal (CDP) y expedientes de terceros en entidades públicas. Angular, Node.js, Prisma, PostgreSQL."
  ogImage={pleromaPreview.src}
  ogType="article"
>
  <!-- Main con estética institucional y legal: Azul marino profundo, índigo y acentos dorados de sello oficial -->
  <main
    class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-indigo-950/40 to-black text-zinc-100 transition-colors"
    x-data="{
      openModal: false,
      currentImage: null,
      currentTitle: '',
      currentDesc: '',
      openLightbox(img, title, desc) {
        this.currentImage = img;
        this.currentTitle = title;
        this.currentDesc = desc;
        this.openModal = true;
        document.body.style.overflow = 'hidden';
      },
      closeLightbox() {
        this.openModal = false;
        document.body.style.overflow = '';
      }
    }"
  >
    <!-- Efecto ambiental: tonos azul marino, índigo y dorado -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="absolute -top-24 -left-20 w-80 h-80 rounded-full bg-indigo-600/15 blur-3xl"></div>
      <div class="absolute top-[30%] -right-24 w-88 h-88 rounded-full bg-blue-600/15 blur-3xl"></div>
      <div class="absolute bottom-10 left-1/3 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl"></div>
    </div>

    <!-- 1. Hero Institucional / Legal -->
    <section class="relative z-10 pt-32 pb-16 px-4 sm:px-8 lg:px-20 max-w-6xl mx-auto text-center">
      <!-- Sello / Badges Oficiales -->
      <div class="flex flex-wrap justify-center items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-amber-500/15 text-amber-400 border border-amber-500/30">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          En Desarrollo Activo · Sector Público
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">
          Normativa Colombiana &amp; CDPs
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-slate-500/15 text-slate-300 border border-slate-500/30">
          Multi-Tenant RBAC
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
        ESP Contrata <br />
        <span class="bg-gradient-to-r from-indigo-400 via-blue-400 to-amber-300 bg-clip-text text-transparent">
          Gestión de Contratación Pública
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-zinc-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Sistema institucional orientado a empresas de servicios públicos (ESP) en Colombia. Centraliza expedientes de contratistas, emisión de Certificados de Disponibilidad Presupuestal (CDP) y resguardo inmutable de auditoría.
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-wrap justify-center items-center gap-4">
        <a
          href="mailto:jairoehr@gmail.com?subject=Solicitud de Acceso a Demo de ESP Contrata"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-bold hover:scale-105 transition-transform shadow-lg shadow-indigo-600/25 text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Solicitar Acceso al Código / Demo</span>
        </a>

        <a
          href="#galeria"
          class="px-5 py-3.5 rounded-full border border-zinc-700 bg-zinc-900/80 text-zinc-200 hover:scale-105 font-bold transition-transform text-sm inline-flex items-center gap-2"
        >
          <span>Ver Capturas del Sistema</span>
        </a>
      </div>
    </section>

    <!-- 2. Contexto Jurídico & Garantías Administrativas -->
    <section class="relative z-10 py-12 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="rounded-3xl border border-indigo-500/20 bg-zinc-900/80 backdrop-blur-md p-6 sm:p-10 shadow-sm space-y-8">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">Rigor Normativo &amp; Control</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">
            Mitigación del Riesgo Legal en la Contratación Estatal
          </h2>
          <p class="text-zinc-300 text-sm sm:text-base leading-relaxed mt-2">
            La contratación en entidades de servicios públicos exige conciliar de forma estricta los rubros presupuestales antes de comprometer recursos. Los procesos dispersos en hojas de cálculo y contratos manuales generaban inconsistencias financieras. ESP Contrata ofrece 3 garantías estructurales:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {legalPillars.map((item, i) => (
            <div class="p-5 rounded-2xl bg-indigo-950/40 border border-indigo-500/20 flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono font-bold text-amber-400">ARTÍCULO 0{i + 1}</span>
                <h3 class="font-bold text-base text-white mt-1">{item.title}</h3>
                <p class="text-xs text-zinc-300 leading-relaxed mt-2">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Fases del Proceso Contractual -->
    <section class="relative z-10 py-12 px-4 sm:px-8 max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-400">Flujo Administrativo</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">
          Fases del Expediente Contractual
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {contractStages.map((stage) => (
          <div class="p-4 rounded-2xl bg-zinc-900/80 border border-zinc-800 text-left flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-indigo-400">ETAPA {stage.step}</span>
              <h4 class="font-bold text-xs sm:text-sm text-white mt-1">{stage.name}</h4>
              <p class="text-[11px] text-zinc-400 mt-1 leading-snug">{stage.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Galería Completa de Capturas (Todas excepto Generador de Documentos) -->
    <section id="galeria" class="relative z-10 py-14 px-4 sm:px-8 max-w-6xl mx-auto border-t border-zinc-800">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">Evidencia del Sistema</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">
          Galería de la Aplicación
        </h2>
        <p class="text-sm text-zinc-400 mt-1">Haz clic en cualquier captura para inspeccionar los módulos de contratación.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {screenshots.map((s) => (
          <button
            type="button"
            @click={`openLightbox('${s.image.src}', '${s.title}', '${s.description}')`}
            class="group text-left rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-sm hover:shadow-md hover:border-indigo-500/50 transition-all cursor-pointer"
          >
            <div class="w-full h-44 overflow-hidden bg-zinc-800 relative">
              <Image
                src={s.image}
                alt={s.title}
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-indigo-500/0 group-hover:bg-indigo-500/10 transition-colors"></div>
            </div>
            <div class="p-3.5">
              <h4 class="font-bold text-sm text-white group-hover:text-indigo-400 transition-colors">
                {s.title}
              </h4>
              <p class="text-xs text-zinc-400 mt-0.5 line-clamp-1">{s.description}</p>
            </div>
          </button>
        ))}
      </div>
    </section>

    <!-- 5. Ficha Técnica & Navegación -->
    <section class="relative z-10 py-14 px-4 sm:px-8 max-w-5xl mx-auto border-t border-zinc-800">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-white">Arquitectura &amp; Tecnologías</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {techStack.map((t) => (
          <div class="p-3.5 rounded-xl bg-zinc-900/80 border border-zinc-800">
            <span class="text-[10px] font-mono text-amber-400 font-semibold">{t.category}</span>
            <div class="font-bold text-sm text-white mt-0.5">{t.name}</div>
            <p class="text-xs text-zinc-400 mt-0.5">{t.detail}</p>
          </div>
        ))}
      </div>

      <div class="flex justify-between items-center pt-6 border-t border-zinc-800">
        <a
          href="/#proyectos"
          class="text-sm font-semibold text-zinc-400 hover:text-white transition-colors inline-flex items-center gap-1.5"
        >
          &larr; Volver a Proyectos
        </a>
        <a
          href="/projects/fraud-detection"
          class="text-sm font-semibold text-indigo-400 hover:underline inline-flex items-center gap-1.5"
        >
          Siguiente: Fraud Detection &rarr;
        </a>
      </div>
    </section>

    <!-- Modal Lightbox (Alpine.js) -->
    <div
      x-cloak
      x-show="openModal"
      x-transition.opacity
      @keydown.escape.window="closeLightbox()"
      class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 sm:p-6"
      style="display: none;"
    >
      <div
        @click.away="closeLightbox()"
        class="relative max-w-4xl w-full bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl"
      >
        <div class="p-4 bg-zinc-900 border-b border-zinc-800 flex items-center justify-between">
          <div>
            <h4 class="font-bold text-white text-sm" x-text="currentTitle"></h4>
            <p class="text-xs text-zinc-400" x-text="currentDesc"></p>
          </div>
          <button
            @click="closeLightbox()"
            class="text-zinc-400 hover:text-white text-xs px-2.5 py-1 rounded bg-zinc-800 transition-colors"
          >
            Cerrar [ESC]
          </button>
        </div>
        <div class="p-2 sm:p-4 max-h-[75vh] overflow-auto flex items-center justify-center bg-black">
          <img :src="currentImage" :alt="currentTitle" class="max-w-full max-h-[70vh] object-contain rounded" />
        </div>
      </div>
    </div>
  </main>
</Layout>
