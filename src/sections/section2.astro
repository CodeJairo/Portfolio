---
import { Image } from "astro:assets";
import fraudPreview from "../assets/fraud-detection/fraud-preview.png";
import higinexPreview from "../assets/higinex/higinex-preview.png";
import pleromaPreview from "../assets/pleroma/pleroma-preview.png";

const projects = [
  {
    title: "Fintech Fraud Detection",
    subtitle: "Streaming · Lakehouse · ML",
    description:
      "Motor de detección de fraude en tiempo real con scoring híbrido, arquitectura Medallion y API de inferencia de baja latencia.",
    href: "/projects/fraud-detection",
    gradient: "from-emerald-500 to-cyan-500",
    badge: "<5ms inferencia",
    image: fraudPreview,
    alt: "Fintech Fraud Detection Platform - Streaming y Lakehouse ML",
  },
  {
    title: "Higinex",
    subtitle: "Ecommerce B2B de aseo",
    description:
      "Plataforma comercial para catálogo por cliente, pedidos y operación administrativa centralizada en distribución mayorista.",
    href: "/projects/higinex",
    gradient: "from-teal-500 to-emerald-500",
    badge: "Proyecto vendido",
    image: higinexPreview,
    alt: "Higinex - Plataforma B2B de comercio electrónico",
  },
  {
    title: "Pleroma",
    subtitle: "Contratación pública",
    description:
      "Sistema en construcción activa para trazabilidad contractual, CDP, terceros y automatización documental.",
    href: "/projects/pleroma",
    gradient: "from-indigo-500 to-purple-500",
    badge: "Desarrollo activo",
    image: pleromaPreview,
    alt: "Pleroma - Sistema de Gestión de Contratación Pública",
  },
  {
    title: "Guardrail API",
    subtitle: "AppSec para OpenAPI",
    description:
      "Paquete orientado a análisis de seguridad en especificaciones API con enfoque SAST/DAST para equipos backend.",
    href: "/projects/guardrail-api",
    gradient: "from-rose-500 to-amber-500",
    badge: "CLI npm",
  },
];
---

<section
  id="proyectos"
  class="bg-gradient-to-b from-white to-gray-100 dark:from-black dark:to-zinc-900 py-20 px-4 sm:px-6 lg:px-16 border-t border-dashed"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-4xl mx-auto mb-12" data-aos="fade-up">
      <p class="text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-semibold">Casos de estudio</p>
      <h2 class="text-4xl font-extrabold text-zinc-900 dark:text-white mt-3">Proyectos técnicos con enfoque de producto</h2>
      <p class="text-zinc-600 dark:text-zinc-300 text-lg mt-4 leading-relaxed">
        Cada proyecto tiene identidad propia y una solución concreta: arquitectura, ejecución y resultados medibles.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {projects.map((project, index) => (
        <article
          class="group rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-900/75 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay={60 + index * 40}
        >
          {
            project.image ? (
              <div class="relative h-52 overflow-hidden">
                <Image src={project.image} alt={project.alt} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
                <div class={`absolute inset-0 bg-gradient-to-t ${project.gradient} opacity-30`}></div>
              </div>
            ) : (
              <div class={`h-52 bg-gradient-to-br ${project.gradient} p-6 flex items-end`}>
                <div class="rounded-2xl border border-white/25 bg-black/25 backdrop-blur-sm px-4 py-3 text-white w-full">
                  <p class="text-xs uppercase tracking-wide opacity-80">API Security</p>
                  <p class="text-lg font-bold">Guardrail API</p>
                </div>
              </div>
            )
          }

          <div class="p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">{project.title}</h3>
                <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 mt-1">{project.subtitle}</p>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
                {project.badge}
              </span>
            </div>

            <p class="text-zinc-600 dark:text-zinc-300 mt-4 leading-relaxed">{project.description}</p>

            <a
              href={project.href}
              class={`inline-flex mt-6 items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r ${project.gradient} text-white text-sm font-bold hover:scale-105 transition-transform`}
            >
              Ver caso de estudio
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
