---
import Card from "../components/card.astro";
import fraudPreview from "../assets/fraud-detection/fraud-preview.png";
import higinexPreview from "../assets/higinex/higinex-preview.png";
import pleromaPreview from "../assets/pleroma/pleroma-preview.png";
import guardrailPreview from "../assets/guardrail/guardrail-preview.svg";
---

<section id="experiencia" aria-labelledby="experiencia-title" class="bg-white dark:bg-black py-20 px-4 sm:px-6 lg:px-16 border-t border-dashed">
  <div class="max-w-7xl mx-auto space-y-16">
    <header class="max-w-3xl" data-aos="fade-up" data-aos-delay="60">
      <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mb-3">Trayectoria profesional</p>
      <h2 id="experiencia-title" class="text-4xl font-bold text-zinc-900 dark:text-white text-balance">Experiencia freelance</h2>
      <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-300 text-pretty">Proyectos y soluciones web desarrollados de forma freelance para clientes reales.</p>
    </header>

    <article class="flex flex-col lg:flex-row items-center gap-12" data-aos="fade-up" data-aos-delay="80">
      <div class="w-full lg:w-1/2" data-aos="fade-right" data-aos-delay="120">
        <Card img={pleromaPreview} alt="ESP Contrata, sistema de gestión de contratación pública" title="ESP Contrata" description="Sistema multi tenant para gestionar terceros, presupuestos, contratos y auditoría en entidades de servicios públicos." techs={[
          { name: "Angular 21", url: "https://angular.dev/" },
          { name: "NestJS", url: "https://nestjs.com/" },
          { name: "PostgreSQL", url: "https://www.postgresql.org/" },
          { name: "AWS S3", url: "https://aws.amazon.com/s3/" },
        ]} href="/projects/esp-contrata" />
      </div>
      <div class="w-full lg:w-1/2 text-left" data-aos="fade-left" data-aos-delay="160">
        <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 mb-3">Desarrollador Full Stack Freelance</p>
        <h3 class="text-3xl font-bold text-zinc-900 dark:text-white mb-4">ESP Contrata</h3>
        <p class="text-zinc-600 dark:text-zinc-300 text-lg leading-relaxed text-pretty">Diseñé la arquitectura multi tenant y los controles de acceso de una plataforma de contratación pública. La solución mantiene aislada la información de cada empresa, registra operaciones críticas y centraliza expedientes, CDP y contratos.</p>
        <a href="/projects/esp-contrata" class="inline-block mt-6 px-6 py-3 rounded-full bg-indigo-600 text-white font-semibold hover:scale-105 active:scale-[0.98] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] shadow-lg shadow-indigo-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">Ver caso de estudio →</a>
      </div>
    </article>

    <article class="flex flex-col lg:flex-row-reverse items-center gap-12" data-aos="fade-up" data-aos-delay="100">
      <div class="w-full lg:w-1/2" data-aos="fade-left" data-aos-delay="140">
        <Card img={higinexPreview} alt="Higinex, plataforma B2B de comercio electrónico de productos de aseo" title="Higinex S.A.S." description="Plataforma de comercio electrónico B2B para catálogo, precios negociados, pedidos e inventario de productos de aseo." techs={[
          { name: "Angular 21", url: "https://angular.dev/" },
          { name: "NestJS", url: "https://nestjs.com/" },
          { name: "PostgreSQL", url: "https://www.postgresql.org/" },
          { name: "Docker", url: "https://www.docker.com/" },
        ]} href="/projects/higinex" />
      </div>
      <div class="w-full lg:w-1/2 text-left" data-aos="fade-right" data-aos-delay="180">
        <p class="text-sm font-semibold text-teal-600 dark:text-teal-400 mb-3">Desarrollador Full Stack Freelance</p>
        <h3 class="text-3xl font-bold text-zinc-900 dark:text-white mb-4">Higinex S.A.S.</h3>
        <p class="text-zinc-600 dark:text-zinc-300 text-lg leading-relaxed text-pretty">Lideré el desarrollo integral de un comercio electrónico B2B para automatizar inventario y ventas a clientes corporativos. Construí una API REST con diseño orientado al dominio, seguridad alineada con OWASP y despliegues reproducibles con Docker.</p>
        <a href="/projects/higinex" class="inline-block mt-6 px-6 py-3 rounded-full bg-emerald-600 text-white font-semibold hover:scale-105 active:scale-[0.98] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] shadow-lg shadow-emerald-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500">Ver caso de estudio →</a>
      </div>
    </article>
  </div>
</section>

<section id="proyectos" aria-labelledby="proyectos-title" class="bg-gray-100 dark:bg-black py-20 px-4 sm:px-6 lg:px-16 border-t border-black/10 dark:border-white/10">
  <div class="max-w-7xl mx-auto space-y-16">
    <header class="max-w-3xl" data-aos="fade-up" data-aos-delay="60">
      <p class="text-sm font-semibold text-cyan-700 dark:text-cyan-400 mb-3">Trabajo técnico independiente</p>
      <h2 id="proyectos-title" class="text-4xl font-bold text-zinc-900 dark:text-white text-balance">Proyectos destacados</h2>
      <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-300 text-pretty">Sistemas construidos para explorar arquitectura backend, datos en tiempo real y seguridad de APIs.</p>
    </header>

    <article class="flex flex-col lg:flex-row items-center gap-12" data-aos="fade-up" data-aos-delay="80">
      <div class="w-full lg:w-1/2" data-aos="fade-right" data-aos-delay="120">
        <Card img={fraudPreview} alt="Fintech Fraud Detection Platform, streaming y aprendizaje automático" title="Fintech Fraud Detection" description="Plataforma de detección de fraude en streaming con arquitectura Medallion, Polars, LightGBM y un microservicio REST de menos de 5 ms." techs={[
          { name: "Python 3.14", url: "https://www.python.org/" },
          { name: "FastAPI", url: "https://fastapi.tiangolo.com/" },
          { name: "Polars", url: "https://pola.rs/" },
          { name: "Redpanda", url: "https://redpanda.com/" },
          { name: "LightGBM", url: "https://lightgbm.readthedocs.io/" },
        ]} href="/projects/fraud-detection" />
      </div>
      <div class="w-full lg:w-1/2 text-left" data-aos="fade-left" data-aos-delay="160">
        <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mb-3">Streaming · Lakehouse · ML en vivo</p>
        <h3 class="text-3xl font-bold text-zinc-900 dark:text-white mb-4">Fintech Fraud Detection Platform</h3>
        <p class="text-zinc-600 dark:text-zinc-300 text-lg leading-relaxed text-pretty">Plataforma de detección de fraude financiero en tiempo real sobre más de 6M de eventos. Integra Redpanda, Polars, LightGBM y un servicio REST con evaluación en menos de 5 ms.</p>
        <div class="flex flex-wrap items-center gap-4 mt-6">
          <a href="/projects/fraud-detection" class="px-6 py-3 rounded-full bg-emerald-600 text-white font-semibold hover:scale-105 active:scale-[0.98] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] shadow-lg shadow-emerald-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500">Ver caso de estudio →</a>
          <a href="https://determined-benevolence-production-da1a.up.railway.app/" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-full border border-black/80 dark:border-white/80 text-black dark:text-white hover:scale-105 active:scale-[0.98] font-semibold transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-black/5 dark:hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 inline-flex items-center gap-2">Probar demo</a>
        </div>
      </div>
    </article>

    <article class="flex flex-col lg:flex-row-reverse items-center gap-12" data-aos="fade-up" data-aos-delay="100">
      <div class="w-full lg:w-1/2" data-aos="fade-left" data-aos-delay="140">
        <Card img={guardrailPreview} alt="Guardrail API, CLI de auditoría de seguridad de APIs" title="Guardrail API" description="Herramienta CLI y paquete npm para auditar APIs mediante análisis OpenAPI, pruebas dinámicas y reportes SARIF para CI/CD." techs={[
          { name: "TypeScript", url: "https://www.typescriptlang.org/" },
          { name: "Node.js", url: "https://nodejs.org/" },
          { name: "OpenAPI 3.0", url: "https://spec.openapis.org/" },
          { name: "Vitest", url: "https://vitest.dev/" },
        ]} href="/projects/guardrail-api" />
      </div>
      <div class="w-full lg:w-1/2 text-left" data-aos="fade-right" data-aos-delay="180">
        <p class="text-sm font-semibold text-cyan-700 dark:text-cyan-400 mb-3">Open source · CLI y npm · DevSecOps</p>
        <h3 class="text-3xl font-bold text-zinc-900 dark:text-white mb-4">Guardrail API</h3>
        <p class="text-zinc-600 dark:text-zinc-300 text-lg leading-relaxed text-pretty">Herramienta CLI para desarrolladores backend y pipelines de CI/CD. Combina análisis de contratos OpenAPI con pruebas activas no destructivas y exporta reportes SARIF 2.1.0.</p>
        <div class="flex flex-wrap items-center gap-4 mt-6">
          <a href="/projects/guardrail-api" class="px-6 py-3 rounded-full bg-cyan-700 text-white font-semibold hover:scale-105 active:scale-[0.98] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] shadow-lg shadow-cyan-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600">Ver caso de estudio →</a>
          <a href="https://github.com/CodeJairo/guardrail-api" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-full border border-black/80 dark:border-white/80 text-black dark:text-white hover:scale-105 active:scale-[0.98] font-semibold transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-black/5 dark:hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 inline-flex items-center gap-2">GitHub repo</a>
        </div>
      </div>
    </article>
  </div>
</section>
